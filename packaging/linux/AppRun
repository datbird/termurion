#!/bin/sh
# The session host sits beside termurion, and the app finds it there by itself.
here="$(dirname "$(readlink -f "$0")")"
# The app takes the AppImage's path from this (and drops it at once) to install its desktop entry.
[ -n "${APPIMAGE:-}" ] && export TERMURION_APPIMAGE="$APPIMAGE"
# The runtime's variables describe this mount, not the shells the app starts; nothing reads them.
unset APPDIR APPIMAGE ARGV0 OWD
exec "$here/usr/bin/termurion" "$@"
