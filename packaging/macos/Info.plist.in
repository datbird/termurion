<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>termurion</string>
  <key>CFBundleIdentifier</key><string>@BUNDLE_ID@</string>
  <key>CFBundleName</key><string>Termurion</string>
  <key>CFBundleDisplayName</key><string>Termurion</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleIconFile</key><string>Termurion</string>
  <key>CFBundleShortVersionString</key><string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key><string>@VERSION@</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
  <key>NSSystemAdministrationUsageDescription</key><string>The operation being performed by a program in Termurion requires elevated permission.</string>
  <key>NSAppleEventsUsageDescription</key><string>An application in Termurion wants to use AppleScript.</string>
  <key>NSBluetoothAlwaysUsageDescription</key><string>An application in Termurion wants to use Bluetooth.</string>
  <key>NSCalendarsUsageDescription</key><string>An application in Termurion wants to use Calendar data.</string>
  <key>NSCameraUsageDescription</key><string>An application in Termurion wants to use the camera.</string>
  <key>NSContactsUsageDescription</key><string>An application in Termurion wants to use your contacts.</string>
  <key>NSLocationAlwaysUsageDescription</key><string>An application in Termurion wants to use your location information, even in the background.</string>
  <key>NSLocationUsageDescription</key><string>An application in Termurion wants to use your location information.</string>
  <key>NSLocationWhenInUseUsageDescription</key><string>An application in Termurion wants to use your location information while active.</string>
  <key>NSMicrophoneUsageDescription</key><string>An application in Termurion wants to use your microphone.</string>
  <key>NSSpeechRecognitionUsageDescription</key><string>An application in Termurion wants to use speech recognition.</string>
  <key>NSRemindersUsageDescription</key><string>An application in Termurion wants to use your reminders.</string>
  <key>NSPhotoLibraryUsageDescription</key><string>An application in Termurion wants to use the photo library.</string>
  <key>NSLocalNetworkUsageDescription</key><string>An application in Termurion wants to access the local network.</string>
  <key>NSDesktopFolderUsageDescription</key><string>A program you run in Termurion wants to use files in your Desktop folder.</string>
  <key>NSDocumentsFolderUsageDescription</key><string>A program you run in Termurion wants to use files in your Documents folder.</string>
  <key>NSDownloadsFolderUsageDescription</key><string>A program you run in Termurion wants to use files in your Downloads folder.</string>
</dict>
</plist>
