#!/usr/bin/env bash
# Copies this repo to EXTREME and runs cargo there.
# Usage: scripts/xt test --lib mouse
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
mount_root=/home/tbird/aiplayground/mount/extreme
# Each checkout (the main one, or a git worktree such as termurion-11e) builds in its own folder on EXTREME,
# named after the checkout, so parallel worktrees never overwrite each other's sources or target/.
name="$(basename "$repo")"
dest="$mount_root/c/Users/datbi/src/$name"
win="C:\\Users\\datbi\\src\\$name"
if ! mountpoint -q "$mount_root"; then
    echo "xt: $mount_root is not mounted. Run: systemctl --user restart sshfs-extreme" >&2
    exit 2
fi
mkdir -p "$dest"
# -rt, not -a: the Windows side cannot take Linux owners or modes.
# target/ and vendor/ live only on EXTREME, and excluded paths survive --delete.
rsync -rt --delete --exclude target/ --exclude vendor/ --exclude .git/ --exclude .superpowers/ "$repo/" "$dest/"
# vendor/ (the shipped ConPTY) lives only on EXTREME: a new worktree folder gets a copy from the main one.
if [ "$name" != termurion ] && [ ! -d "$dest/vendor" ]; then
    ssh extreme "Copy-Item -Recurse 'C:\\Users\\datbi\\src\\termurion\\vendor' '$win\\vendor'"
fi
ssh extreme "cd '$win'; cargo $*; exit \$LASTEXITCODE"
