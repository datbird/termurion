#!/usr/bin/env bash
# Copies this repo to a Windows build host and runs cargo there.
# Usage: scripts/xt test --lib mouse
#
# Machine-specific values come from the environment, or from an optional file
# scripts/xt.local (gitignored, plain shell) that this script sources:
#   XT_HOST           ssh alias of the Windows build host
#   XT_MOUNT          local mount root of that host's C: drive parent (the folder holding c/)
#   XT_WIN_HOME       the Windows home folder, for example C:\Users\name
#   XT_MOUNT_SERVICE  systemd user unit that keeps the mount up (named in the error message)
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
if [ -f "$repo/scripts/xt.local" ]; then
    # shellcheck disable=SC1091
    . "$repo/scripts/xt.local"
fi
for v in XT_HOST XT_MOUNT XT_WIN_HOME XT_MOUNT_SERVICE; do
    if [ -z "${!v:-}" ]; then
        echo "xt: $v is not set. Export it or put it in scripts/xt.local (see the header of scripts/xt)." >&2
        exit 2
    fi
done
mount_root="$XT_MOUNT"
# Each checkout (the main one, or a git worktree such as termurion-11e) builds in its own folder on the Windows host,
# named after the checkout, so parallel worktrees never overwrite each other's sources or target/.
name="$(basename "$repo")"
# The Windows home as a path under the mount: C:\Users\name -> c/Users/name
win_home_rel="$(printf '%s' "$XT_WIN_HOME" | sed -e 's#\\#/#g' -e 's#^\([A-Za-z]\):#\L\1#')"
dest="$mount_root/$win_home_rel/src/$name"
win="$XT_WIN_HOME\\src\\$name"
if ! mountpoint -q "$mount_root"; then
    echo "xt: $mount_root is not mounted. Run: systemctl --user restart $XT_MOUNT_SERVICE" >&2
    exit 2
fi
mkdir -p "$dest"
# -rt, not -a: the Windows side cannot take Linux owners or modes.
# target/ and vendor/ live only on the Windows host, and excluded paths survive --delete.
rsync -rt --delete --exclude target/ --exclude vendor/ --exclude .git/ --exclude .superpowers/ "$repo/" "$dest/"
# vendor/ (the shipped ConPTY) lives only on the Windows host: a new worktree folder gets a copy from the main one.
if [ "$name" != termurion ] && [ ! -d "$dest/vendor" ]; then
    ssh "$XT_HOST" "Copy-Item -Recurse '$XT_WIN_HOME\\src\\termurion\\vendor' '$win\\vendor'"
fi
ssh "$XT_HOST" "cd '$win'; cargo $*; exit \$LASTEXITCODE"
