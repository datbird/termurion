#!/usr/bin/env bash
# Builds target/linux/Termurion-<version>-x86_64.AppImage from a release build made in an Ubuntu 22.04 container.
# appimagetool and the type2 runtime (the first code that runs on a user's machine) are fetched once
# to ~/.cache/termurion/ at pinned releases and used only after their SHA-256 matches; the runtime is
# handed to appimagetool, which would otherwise fetch the moving "continuous" one.
# It also writes the .zsync beside it and embeds the update information, so AppImageUpdate and
# AppImage managers can update the file in place from the latest GitHub release.
# Needs zsyncmake on the host (apt install zsync); appimagetool runs here, not in the container.
# Usage: scripts/linux-appimage
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo"
tool_ver=1.9.1
tool_sha=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
tool_url="https://github.com/AppImage/appimagetool/releases/download/$tool_ver/appimagetool-x86_64.AppImage"
# Release 20251108 of AppImage/type2-runtime; its runtime-x86_64.sig checks against the release key.
runtime_ver=20251108
runtime_sha=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
runtime_url="https://github.com/AppImage/type2-runtime/releases/download/$runtime_ver/runtime-x86_64"
cache="$HOME/.cache/termurion"
tool="$cache/appimagetool-$tool_ver-x86_64.AppImage"
runtime="$cache/runtime-$runtime_ver-x86_64"
die() { echo "linux-appimage: $1" >&2; exit 1; }
[ "$(uname -m)" = x86_64 ] || die "x86_64 only"
command -v zsyncmake > /dev/null || die "zsyncmake is missing (apt install zsync); the .zsync file is part of the release"

ver=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
[ -n "$ver" ] || die "no version in Cargo.toml"

mkdir -p "$cache"
# fetch <file> <sha256> <url> <name>: the cached file when its hash matches, else a fresh download
# that must match before anything uses it.
ok() { [ -f "$1" ] && [ "$(sha256sum "$1" | cut -d' ' -f1)" = "$2" ]; }
fetch() {
  ok "$1" "$2" && return 0
  rm -f "$1"
  curl -fsSL -o "$1.part" "$3" || die "$4 download failed"
  mv "$1.part" "$1"
  ok "$1" "$2" || { rm -f "$1"; die "$4 hash mismatch, not using it"; }
}
fetch "$tool" "$tool_sha" "$tool_url" appimagetool
fetch "$runtime" "$runtime_sha" "$runtime_url" "the AppImage runtime"
chmod +x "$tool"

# The build runs in an Ubuntu 22.04 container so the binaries need glibc 2.35 at most. A separate
# target dir keeps the host's target/release alone; the cargo registry lives in a docker volume.
image=termurion-appimage-builder
docker build -q -t "$image" -f packaging/linux/appimage-builder.Dockerfile packaging/linux > /dev/null || die "builder image failed"
tgt=target/linux-2204
mkdir -p "$tgt"
# Libraries a stock desktop may lack and the binaries dlopen or link. glibc, GL, Vulkan, Wayland and
# the core X11 and xcb libraries stay out: they must come from the host.
bundle="libxkbcommon.so.0 libxkbcommon-x11.so.0 libxcb-xkb.so.1"
docker run --rm -i -u "$(id -u):$(id -g)" -e HOME=/tmp/home -e CARGO_TARGET_DIR="/src/$tgt" -e TGT="/src/$tgt" \
  -e BUNDLE="$bundle" -v "$repo:/src" -v termurion-cargo-registry:/opt/cargo/registry -w /src "$image" \
  bash -se <<'INNER' || die "build failed"
cargo build --release --bins
rm -rf "$TGT/lib"; mkdir -p "$TGT/lib"
for l in $BUNDLE; do
  cp -L "$(ldconfig -p | awk -v l="$l" '$1==l && /x86-64/ {print $NF; exit}')" "$TGT/lib/$l"
  # Bundled libraries find each other beside themselves.
  patchelf --set-rpath '$ORIGIN' "$TGT/lib/$l"
done
# The app dlopens xkbcommon; its own RUNPATH finds the bundle, so no LD_LIBRARY_PATH is needed anywhere.
patchelf --set-rpath '$ORIGIN/../lib' "$TGT/release/termurion"
INNER

app=target/linux/AppDir
rm -rf "$app"
mkdir -p "$app/usr/bin" "$app/usr/share/icons/hicolor/256x256/apps"
for b in termurion termurion-host termurion-git termurion-utils; do
  [ -x "$tgt/release/$b" ] && cp "$tgt/release/$b" "$app/usr/bin/"
done
[ -x "$app/usr/bin/termurion-host" ] || die "termurion-host was not built"
mkdir -p "$app/usr/lib"
cp "$tgt"/lib/*.so* "$app/usr/lib/"
cp packaging/linux/AppRun "$app/AppRun"
cp packaging/linux/dev.termurion.Termurion.desktop "$app/"
icon=docs/assets/termurion/termurion-icon-256.png
cp "$icon" "$app/dev.termurion.Termurion.png"
cp "$icon" "$app/usr/share/icons/hicolor/256x256/apps/dev.termurion.Termurion.png"

out="target/linux/Termurion-$ver-x86_64.AppImage"
# The release asset keeps this name; AppImageUpdate looks up the newest release and its .zsync.
upd='gh-releases-zsync|datbird|termurion|latest|Termurion-*-x86_64.AppImage.zsync'
# appimagetool leaves the .zsync in the current folder; it is moved beside the AppImage below.
zs="$(basename "$out").zsync"
rm -f "$out" "$out.zsync" "$zs"
# Checked again right before use: nothing may swap the cached runtime after the fetch.
ok "$runtime" "$runtime_sha" || die "the AppImage runtime changed in the cache, not using it"
ARCH=x86_64 "$tool" --appimage-extract-and-run --runtime-file "$runtime" -u "$upd" "$app" "$out" >&2 || die "appimagetool failed"
[ -s "$zs" ] || die "appimagetool wrote no $zs"
mv "$zs" "$out.zsync"
got=$("$out" --appimage-updateinformation 2>&1) || die "could not read the update information from $out"
[ "$got" = "$upd" ] || die "wrong update information in $out: $got"
echo "linux-appimage: $out"
echo "linux-appimage: $out.zsync"
