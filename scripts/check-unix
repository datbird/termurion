#!/usr/bin/env bash
# Counts compile errors on Linux (here) and macOS (ssh funtimes). Exits 1 if either is non-zero.
# Usage: scripts/check-unix [--linux-only | --mac-only]
set -uo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo"
do_linux=1; do_mac=1
case "${1:-}" in
    --linux-only) do_mac=0 ;;
    --mac-only) do_linux=0 ;;
    "") ;;
    *) echo "usage: scripts/check-unix [--linux-only | --mac-only]" >&2; exit 2 ;;
esac
bad=0
# Short format puts each diagnostic as path:line:col: error[..], so match those (plus bare error: lines from cargo itself, minus the summary).
count() { grep -E '^([^ ]+:[0-9]+:[0-9]+: )?error' | grep -vc 'could not compile' || true; }
if [ "$do_linux" = 1 ]; then
    # shellcheck disable=SC1090
    [ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
    n=$(cargo check --all-targets --message-format short 2>&1 | count)
    echo "linux: $n errors"
    [ "$n" -ne 0 ] && bad=1
fi
if [ "$do_mac" = 1 ]; then
    rsync -rt --delete --exclude target/ --exclude .git/ --exclude .superpowers/ ./ funtimes:src/termurion/ || { echo "check-unix: rsync to funtimes failed" >&2; exit 2; }
    n=$(ssh funtimes 'cd src/termurion && ~/.cargo/bin/cargo check --all-targets --message-format short' 2>&1 | count)
    echo "macos: $n errors"
    [ "$n" -ne 0 ] && bad=1
fi
exit $bad
