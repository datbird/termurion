#!/usr/bin/env bash
# Type-checks the Windows build (lib, lib tests and the binaries) from Linux or macOS, with no Windows machine.
# It runs `cargo check --target x86_64-pc-windows-msvc`. The bundled sqlite build script wants
# MSVC cl.exe and lib.exe, so stand-ins that write empty outputs go first on PATH: a check never
# links, so those objects are never used. This proves the code compiles, not that it runs;
# scripts/xt on a Windows machine is still the test run.
# Prints every warning and error with its location, then "windows: E errors, W warnings".
# Exits 1 on any error. Needs the target once: rustup target add x86_64-pc-windows-msvc
# Usage: scripts/win-check
set -uo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo"
target_dir="${WIN_CHECK_TARGET_DIR:-$repo/target/win-check}"
stubs="$target_dir/msvc-stubs"
mkdir -p "$stubs"
cat > "$stubs/stub" <<'EOF'
#!/bin/sh
for a in "$@"; do
  case "$a" in
    /OUT:*|-OUT:*|/out:*|-out:*) : > "${a#*:}" ;;
    /Fo*|-Fo*) : > "${a#??}" ;;
  esac
done
exit 0
EOF
chmod +x "$stubs/stub"
ln -sf stub "$stubs/cl.exe"
ln -sf stub "$stubs/lib.exe"
cargo="${CARGO:-cargo}"
command -v "$cargo" >/dev/null || cargo="$HOME/.cargo/bin/cargo"
out="$(PATH="$stubs:$PATH" "$cargo" check --lib --tests --bins --target x86_64-pc-windows-msvc --target-dir "$target_dir" 2>&1)"
status=$?
# The conpty files are fetched on Windows only, so their build-script notice is noise here.
diag="$(printf '%s\n' "$out" | grep -E -A3 '^(warning|error)' | grep -E '^(warning|error)|-->' | grep -vE 'fetch-conpty|generated [0-9]+ warning|could not compile|aborting due')"
[ -n "$diag" ] && printf '%s\n' "$diag"
errors="$(printf '%s\n' "$out" | grep -E '^error' | grep -cvE 'could not compile|aborting due|failed to run custom build' || true)"
warnings="$(printf '%s\n' "$diag" | grep -c '^warning' || true)"
echo "windows: $errors errors, $warnings warnings"
[ "$status" = 0 ] && [ "$errors" = 0 ]
