#!/usr/bin/env bash
# Drives the real Termurion window on a private X server and says PASS or FAIL for one scenario.
# Usage: scripts/unix-gui-check <scenario>      scenarios: shell, layout, menubar, popup, host, job, clipboard, notify, hotkey, hotkey-refused, tmux, tmux-nolang, tmux-lcall, tmux-windows,
# restore-windows, restore-host, tmux-restore [a|b|c|d], paste [x11|wayland], alert [x11|wayland]
#
# alert: the update question ("Check for updates automatically?") a second launch asks, a dialog
# fitted to its content. Its window must get its height before it shows and keep it: on X11 the
# window's height stays the same once mapped and is under its creation height; on Wayland (weston,
# WAYLAND_DEBUG) every set_window_geometry of its surface is the same height, under the creation
# height, and no configure from the compositor names another height.
#
# paste: a word copied in one pane (Ctrl+Shift+C, with copy on select off) and pasted in the other
# (Ctrl+Shift+V). Variant x11 runs the app on Xvfb; wayland runs it on a weston nested in Xvfb (x11
# backend, kiosk shell, no Xwayland, so no X server for the app), which has no data-control protocol,
# like GNOME. With no variant the scenario runs both.
#
# tmux-restore: a relaunch on the same config after a tmux -CC gateway was open. Variant a: shells in
# the app, quit with the chord. b: shells in the session host, kill -9 of the app (the host reopens
# it). c: b with the tmux server killed before the reopen. d (not in the default run): b with a new
# tmux window made 50 ms before the kill, so a reply to the app's own command may be in flight.
# With no variant the scenario runs a, b and c.
#
# Needs Xvfb, xdotool and ImageMagick's import. Proof is a file, not pixels: each pane runs
# `echo $$ >> $SCRATCH/pids`, and a screenshot (screen.png) is kept for a person to look at.
# The hotkey scenario also needs openbox and xterm: the hotkey window comes front on Ctrl+Alt+Space,
# and a second press hands focus back to the xterm that had it. hotkey-refused sets the hotkey to
# Ctrl+Alt+F12, which the stock keymap makes a console switch: the grab is refused, and the app must
# not be left with no window.
# TERMURION_BIN names another build to run (an AppImage; add TERMURION_BIN_ARGS=--appimage-extract-and-run
# where FUSE is missing) and skips the debug build.
# The app runs with HOME, TMPDIR and XDG_RUNTIME_DIR under target/gui-check/<scenario>/ (and no
# XDG_DATA_HOME, so an AppImage run's desktop entry lands in that HOME).
# Keys go through XTEST (xdotool type/key, never --window), with no window manager, so the
# window is focused by hand. The menubar scenario clicks the in-window menu bar; where its titles and
# items sit comes from the ignored test app::menu::tests::print_bar_layout (same fonts, same layout code). No chord uses the Super key: Command is Ctrl+Shift (shortcut_key.rs),
# so New Tab (newSession:, Cmd+T) is ctrl+shift+t and Split Vertically (splitVertically:, Cmd+D)
# is ctrl+shift+d.
set -uo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo"
scenario="${1:-}"
variant="${2:-}"
case "$scenario" in
    shell | layout | menubar | popup | host | job | clipboard | notify | hotkey | hotkey-refused | tmux | tmux-nolang | tmux-lcall | tmux-windows | restore-windows | restore-host) ;;
    tmux-restore)
        case "$variant" in
            a | b | c | d) ;;
            "")
                # All three variants, one run each; the scenario passes when every one does.
                bad=0
                for v in a b c; do "$0" tmux-restore "$v" || bad=1; done
                [ "$bad" -eq 0 ] && echo "PASS tmux-restore"
                exit "$bad"
                ;;
            *) echo "usage: scripts/unix-gui-check tmux-restore [a|b|c|d]" >&2; exit 2 ;;
        esac
        ;;
    paste)
        case "$variant" in
            x11 | wayland) ;;
            "")
                bad=0
                for v in x11 wayland; do "$0" paste "$v" || bad=1; done
                [ "$bad" -eq 0 ] && echo "PASS paste"
                exit "$bad"
                ;;
            *) echo "usage: scripts/unix-gui-check paste [x11|wayland]" >&2; exit 2 ;;
        esac
        ;;
    alert)
        case "$variant" in
            x11 | wayland) ;;
            "")
                bad=0
                for v in x11 wayland; do "$0" alert "$v" || bad=1; done
                [ "$bad" -eq 0 ] && echo "PASS alert"
                exit "$bad"
                ;;
            *) echo "usage: scripts/unix-gui-check alert [x11|wayland]" >&2; exit 2 ;;
        esac
        ;;
    *) echo "usage: scripts/unix-gui-check <shell|layout|menubar|popup|host|job|clipboard|notify|hotkey|hotkey-refused|tmux|tmux-nolang|tmux-lcall|tmux-windows|restore-windows|restore-host|tmux-restore [a|b|c|d]|paste [x11|wayland]|alert [x11|wayland]>" >&2; exit 2 ;;
esac
# The notify scenario runs on a private session bus, watched by dbus-monitor for the Notify call.
if [ "$scenario" = notify ] && [ -z "${GUICHECK_BUS:-}" ]; then
    for tool in dbus-run-session dbus-monitor; do
        command -v "$tool" > /dev/null || { echo "FAIL $scenario: $tool is not installed"; exit 1; }
    done
    exec env GUICHECK_BUS=1 dbus-run-session -- "$0" "$@"
fi
# The tmux scenarios: tmux (tabs in the attaching window), tmux-nolang (the app starts with no locale
# variable), tmux-lcall (the app starts with LC_ALL=C), tmux-windows (the default: a new Termurion window).
is_tmux=false
case "$scenario" in tmux*) is_tmux=true ;; esac
tools="Xvfb xdotool import"
$is_tmux && tools="$tools tmux"
case "$scenario" in hotkey | hotkey-refused) tools="$tools openbox xterm xprop" ;; popup) tools="$tools compare" ;; esac
wayland=false
{ [ "$scenario" = paste ] || [ "$scenario" = alert ]; } && [ "$variant" = wayland ] && { wayland=true; tools="$tools weston"; }
[ "$scenario" = alert ] && tools="$tools xwininfo"
for tool in $tools; do
    command -v "$tool" > /dev/null || { echo "FAIL $scenario: $tool is not installed"; exit 1; }
done
# xclip may sit in ~/.local/bin, which a non-login shell does not have on PATH.
xclip_bin=$(command -v xclip || true)
[ -z "$xclip_bin" ] && [ -x "$HOME/.local/bin/xclip" ] && xclip_bin="$HOME/.local/bin/xclip"
if { [ "$scenario" = clipboard ] || [ "$scenario" = menubar ] || [ "$scenario" = popup ]; } && [ -z "$xclip_bin" ]; then
    echo "FAIL $scenario: xclip is not installed"
    exit 1
fi
# shellcheck disable=SC1090
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

display="${GUICHECK_DISPLAY:-:97}"
scratch="$repo/target/gui-check/$scenario${variant:+-$variant}"
rm -rf "$scratch"
mkdir -p "$scratch/home" "$scratch/tmp" "$scratch/run"
chmod 700 "$scratch/run"
: > "$scratch/pids"

xvfb_pid="" app_pid="" zenity_pid="" monitor_pid="" wm_pid="" xterm_pid="" weston_pid=""
# The pid and its children, grandchildren and so on (an AppImage's runtime starts the app as a child).
family() {
    local p
    echo "$1"
    for p in $(pgrep -P "$1" 2> /dev/null); do family "$p"; done
}
cleanup() {
    [ -n "$app_pid" ] && kill $(family "$app_pid") 2> /dev/null
    # The job scenario's question box is a child that would outlive the app.
    [ -n "$zenity_pid" ] && kill "$zenity_pid" 2> /dev/null
    # A session host this run started holds this scratch XDG_RUNTIME_DIR in its environment.
    for p in /proc/[0-9]*; do
        [ -r "$p/comm" ] && [ "$(cat "$p/comm" 2> /dev/null)" = termurion-host ] \
            && tr '\0' '\n' < "$p/environ" 2> /dev/null | grep -qx "XDG_RUNTIME_DIR=$scratch/run" \
            && kill "${p#/proc/}" 2> /dev/null
    done
    # The tmux scenario's server, by its own socket name.
    $is_tmux && tmux -L guicheck kill-server 2> /dev/null
    [ -n "$monitor_pid" ] && kill "$monitor_pid" 2> /dev/null
    [ -n "$xterm_pid" ] && kill "$xterm_pid" 2> /dev/null
    [ -n "$wm_pid" ] && kill "$wm_pid" 2> /dev/null
    [ -n "$weston_pid" ] && kill "$weston_pid" 2> /dev/null
    [ -n "$xvfb_pid" ] && kill "$xvfb_pid" 2> /dev/null
    return 0
}
trap cleanup EXIT
fail() {
    echo "FAIL $scenario: $1"
    # What the guicheck server holds, for a person reading the failure.
    $is_tmux && { tmux -L guicheck list-panes -a -F '#{window_id} #{pane_id} #{pane_pid}' 2> /dev/null; tmux -L guicheck capture-pane -p -t '%0' 2> /dev/null | head -8; }
    exit 1
}

$is_tmux && tmux -L guicheck kill-server 2> /dev/null
[ -n "${TERMURION_BIN:-}" ] || cargo build --bins > "$scratch/build.log" 2>&1 || { tail -5 "$scratch/build.log" >&2; fail "cargo build --bins"; }

Xvfb "$display" -screen 0 1600x1000x24 -nolisten tcp > "$scratch/xvfb.log" 2>&1 &
xvfb_pid=$!
for _ in $(seq 50); do [ -S "/tmp/.X11-unix/X${display#:}" ] && break; sleep 0.1; done
[ -S "/tmp/.X11-unix/X${display#:}" ] || fail "Xvfb did not start"

export DISPLAY="$display" SCRATCH="$scratch" SHELL=/bin/bash
# The Wayland variant: a weston window on the Xvfb takes the XTEST keys and clicks and hands them to
# its Wayland clients. Kiosk shell puts the app full size at the output's corner.
if $wayland; then
    # Kiosk shell makes every window full screen; the alert scenario needs a desktop's own sizing.
    wshell=kiosk-shell.so
    [ "$scenario" = alert ] && wshell=desktop-shell.so
    XDG_RUNTIME_DIR="$scratch/run" weston --backend=x11-backend.so --renderer=pixman --shell="$wshell" \
        --socket=wl-guicheck --width=1200 --height=800 --idle-time=0 > "$scratch/weston.log" 2>&1 &
    weston_pid=$!
    for _ in $(seq 50); do [ -S "$scratch/run/wl-guicheck" ] && break; sleep 0.1; done
    [ -S "$scratch/run/wl-guicheck" ] || fail "weston did not start (see $scratch/weston.log)"
fi
# A second launch (SUHasLaunchedBefore) that never answered the update question asks it at once.
if [ "$scenario" = alert ]; then
    mkdir -p "$scratch/home/.config/termurion"
    printf '[settings]\nSUHasLaunchedBefore = true\n' > "$scratch/home/.config/termurion/settings.toml"
fi
# Copy on select is off for paste, so only the Copy key can put the word on the clipboard.
if [ "$scenario" = paste ]; then
    mkdir -p "$scratch/home/.config/termurion"
    printf '[settings]\nCopySelection = false\nSUEnableAutomaticChecks = false\n' > "$scratch/home/.config/termurion/settings.toml"
fi
# The host scenario runs its shells in termurion-host (the setting is read at startup).
if [ "$scenario" = host ] || [ "$scenario" = restore-host ]; then
    mkdir -p "$scratch/home/.config/termurion"
    printf '[settings]\nRunJobsInServers = true\nSUEnableAutomaticChecks = false\n' > "$scratch/home/.config/termurion/settings.toml"
fi
# restore-windows keeps the shells in the app, so a quit ends them and only the saved windows remain.
if [ "$scenario" = restore-windows ]; then
    mkdir -p "$scratch/home/.config/termurion"
    printf '[settings]\nRunJobsInServers = false\nSUEnableAutomaticChecks = false\n' > "$scratch/home/.config/termurion/settings.toml"
fi
# The clipboard scenario binds the middle button to Paste from Selection (the factory binding pastes the clipboard).
if [ "$scenario" = clipboard ]; then
    mkdir -p "$scratch/home/.config/termurion"
    printf '[settings.PointerActions."Button,2,1,,"]\nAction = "kPasteFromSelectionPointerAction"\nArgument = ""\n' > "$scratch/home/.config/termurion/settings.toml"
fi
# The tmux scenario opens tmux windows as tabs of the attaching window (mode 2), so the typing below has a tab to land in.
if [ "$scenario" != tmux-windows ] && [ "$scenario" != tmux-restore ] && $is_tmux; then
    mkdir -p "$scratch/home/.config/termurion"
    printf '[settings]\nOpenTmuxWindowsIn = 2\n' > "$scratch/home/.config/termurion/settings.toml"
fi
# tmux-restore: tabs for tmux windows; the shells live in the host for b and c, in the app for a.
if [ "$scenario" = tmux-restore ]; then
    mkdir -p "$scratch/home/.config/termurion"
    jobs_in_servers=true
    [ "$variant" = a ] && jobs_in_servers=false
    printf '[settings]\nOpenTmuxWindowsIn = 2\nRunJobsInServers = %s\nSUEnableAutomaticChecks = false\n' "$jobs_in_servers" > "$scratch/home/.config/termurion/settings.toml"
fi
# The job scenario's profile asks before closing a session that runs a job (a new profile never asks).
if [ "$scenario" = job ]; then
    mkdir -p "$scratch/home/.config/termurion"
    printf 'default = "job-check"\n\n[[profile]]\nGuid = "job-check"\nName = "Default"\n"Prompt Before Closing 2" = 2\n' > "$scratch/home/.config/termurion/profiles.toml"
fi
# The hotkey scenarios have a profile with a hotkey (key code 0x31 is Space, 111 is F12; Control and Option flags).
case "$scenario" in
    hotkey | hotkey-refused)
        mkdir -p "$scratch/home/.config/termurion"
        code=49 chars=" "
        [ "$scenario" = hotkey-refused ] && code=111 chars=$(printf '\357\234\217')
        printf 'default = "hk-main"\n\n[[profile]]\nGuid = "hk-main"\nName = "Default"\n\n[[profile]]\nGuid = "hk-drop"\nName = "Dropdown"\n"Has Hotkey" = true\n"HotKey Key Code" = %s\n"HotKey Modifier Flags" = 786432\n"HotKey Characters Ignoring Modifiers" = "%s"\n"HotKey Window AutoHides" = true\n"HotKey Window Animates" = false\n' "$code" "$chars" > "$scratch/home/.config/termurion/profiles.toml"
        # With a hotkey profile and nothing to restore the app starts with only a hidden hotkey window, so
        # the hotkey scenario asks for a plain window; hotkey-refused must get one by itself.
        always=true
        [ "$scenario" = hotkey-refused ] && always=false
        printf '[settings]\nSUEnableAutomaticChecks = false\nAlwaysOpenWindowAtStartup = %s\n' "$always" > "$scratch/home/.config/termurion/settings.toml"
        HOME="$scratch/home" openbox --sm-disable > "$scratch/openbox.log" 2>&1 &
        wm_pid=$!
        for _ in $(seq 50); do xprop -root _NET_SUPPORTING_WM_CHECK 2> /dev/null | grep -q "window id" && break; sleep 0.1; done
        ;;
esac
# The locale the app itself starts under, for the tmux variants.
locale_env=()
[ "$scenario" = tmux-nolang ] && locale_env=(-u LANG -u LC_ALL -u LC_CTYPE)
[ "$scenario" = tmux-lcall ] && locale_env=(LC_ALL=C)
# A box needs a window manager to be mapped (zenity 4 under bare Xvfb draws nothing), so the quit
# question in restore-windows is answered by a zenity that says OK at once.
if [ "$scenario" = restore-windows ] || [ "$scenario" = tmux-restore ]; then
    mkdir -p "$scratch/bin"
    printf '#!/bin/sh\necho "$@" >> "%s/zenity.log"\nexit 0\n' "$scratch" > "$scratch/bin/zenity"
    chmod +x "$scratch/bin/zenity"
    export PATH="$scratch/bin:$PATH"
fi
launch_app() {
    # On weston the app has no X server: no DISPLAY, only the weston socket.
    local display_env=(-u WAYLAND_DISPLAY) wayland_env=()
    $wayland && { display_env=(-u DISPLAY); wayland_env=(WAYLAND_DISPLAY=wl-guicheck); }
    # The alert scenario reads the Wayland requests and events from the app's log.
    [ "$scenario" = alert ] && $wayland && wayland_env+=(WAYLAND_DEBUG=client)
    env -u TMUX "${display_env[@]}" -u XDG_CONFIG_HOME -u XDG_STATE_HOME -u XDG_DATA_HOME "${locale_env[@]}" "${wayland_env[@]}" HOME="$scratch/home" TMPDIR="$scratch/tmp" XDG_RUNTIME_DIR="$scratch/run" \
        "${TERMURION_BIN:-$repo/target/debug/termurion}" ${TERMURION_BIN_ARGS:-} >> "$scratch/app.log" 2>&1 &
    app_pid=$!
    # Behind an AppImage runtime the app is a child: from here app_pid is the app itself.
    if [ -n "${TERMURION_BIN:-}" ]; then
        local p
        for _ in $(seq 100); do
            for p in $(family "$app_pid"); do
                [ "$(cat "/proc/$p/comm" 2> /dev/null)" = termurion ] && { app_pid=$p; return; }
            done
            sleep 0.1
        done
    fi
}
# The pane shells of this run: bash under the app or its host, with this run's SCRATCH.
run_shells() {
    local p parent
    for p in /proc/[0-9]*; do
        [ "$(cat "$p/comm" 2> /dev/null)" = bash ] || continue
        parent=$(ps -o comm= -p "$(ps -o ppid= -p "${p#/proc/}" 2> /dev/null | tr -d ' ')" 2> /dev/null)
        case "$parent" in termurion | termurion-host) ;; *) continue ;; esac
        tr '\0' '\n' < "$p/environ" 2> /dev/null | grep -qx "SCRATCH=$scratch" && echo "${p#/proc/}"
    done
}
# Finds the app's window and focuses it by hand (no window manager).
find_window() {
    # Polled: `search --sync` never returns under a window manager that reparents the window.
    win=""
    for _ in $(seq 300); do
        if $wayland; then
            # On weston the X window is weston's (it sets no pid); the app is up once a shell of this run is.
            win=$(xdotool search --onlyvisible --classname weston 2> /dev/null | tail -1)
            [ -n "$win" ] && [ -z "$(run_shells)" ] && win=""
        else
            win=$(xdotool search --onlyvisible --pid "$app_pid" 2> /dev/null | tail -1)
        fi
        [ -n "$win" ] && break
        sleep 0.1
    done
    [ -n "$win" ] || fail "no window for pid $app_pid (see $scratch/app.log)"
    xdotool windowfocus --sync "$win" 2> /dev/null || true
    sleep 2
}
[ "$scenario" = notify ] && { dbus-monitor --session "interface='org.freedesktop.Notifications',member='Notify'" > "$scratch/bus.log" 2>&1 & monitor_pid=$!; sleep 1; }
launch_app
find_window

# Types the pid line into whichever pane has focus, then waits for it to land in the file.
want=0
type_pid_line() {
    xdotool type --delay 20 'echo $$ >> "$SCRATCH/pids"'
    xdotool key Return
    want=$((want + 1))
    for _ in $(seq 100); do
        [ "$(wc -l < "$scratch/pids")" -ge "$want" ] && return 0
        sleep 0.1
    done
    fail "pane $want never wrote its pid (see $scratch/screen.png)"
}
shoot() { import -window root "$scratch/screen.png" 2> /dev/null || true; }

case "$scenario" in
    shell)
        sleep 1
        type_pid_line
        shoot
        [ "$(sort -u "$scratch/pids" | wc -l)" -eq 1 ] || fail "expected one pid: $(tr '\n' ' ' < "$scratch/pids")"
        # An AppImage's runtime variables are the app's, never the shell's.
        leaked=$(tr '\0' '\n' < "/proc/$(head -1 "$scratch/pids")/environ" 2> /dev/null | grep -E '^(APPDIR|APPIMAGE|ARGV0|OWD|TERMURION_APPIMAGE)=' | cut -d= -f1 | tr '\n' ' ')
        [ -z "$leaked" ] || fail "the shell has the AppImage's $leaked"
        # An AppImage run installs its desktop entry (and icon) under the scratch home, Exec on the AppImage.
        case "${TERMURION_BIN:-}" in
            *.AppImage)
                entry="$scratch/home/.local/share/applications/dev.termurion.Termurion.desktop"
                grep -qxF "X-Termurion-AppImage=true" "$entry" 2> /dev/null || fail "no desktop entry for the AppImage at $entry"
                # Exec names the AppImage by its absolute path (the runtime's APPIMAGE); a path with a
                # character the entry escapes is checked only for the quoted form.
                appimage=$(realpath "$TERMURION_BIN")
                case "$appimage" in
                    *[!A-Za-z0-9/._+-]*) grep -q '^Exec=".*" %U$' "$entry" || fail "the entry's Exec is not one quoted path" ;;
                    *) grep -qxF "Exec=\"$appimage\" %U" "$entry" || fail "the entry's Exec is not $appimage" ;;
                esac
                icon="$scratch/home/.local/share/icons/hicolor/256x256/apps/dev.termurion.Termurion.png"
                [ -s "$icon" ] || fail "no icon beside the desktop entry"
                # The icon by its absolute path, so gnome-shell finds it without a restart.
                grep -qxF "Icon=$icon" "$entry" || fail "the entry's Icon is not $icon"
                ;;
        esac
        ;;
    notify)
        sleep 1
        # OSC 9 is a notification; the bus sees a Notify call whose body ends in the text (the app puts the session name in front).
        xdotool type --delay 20 "printf '\\033]9;hello\\a'"
        xdotool key Return
        for _ in $(seq 50); do grep -q 'string ".*hello"' "$scratch/bus.log" && break; sleep 0.1; done
        shoot
        grep -q 'member=Notify' "$scratch/bus.log" || fail "no Notify call on the bus (see $scratch/bus.log, $scratch/app.log)"
        grep -q 'string ".*hello"' "$scratch/bus.log" || fail "the Notify call has no body ending in hello (see $scratch/bus.log)"
        ;;
    hotkey-refused)
        # The window the app opened by itself is the proof: find_window found it. It is a normal window, shown.
        [ -n "$win" ] || fail "no window"
        shoot
        ;;
    hotkey)
        sleep 1
        # An xterm holds focus. The chord shows the hotkey window (a second window of the app, active); the
        # chord again hides it and the xterm is active once more.
        xterm -T hkxterm -e sleep 600 &
        xterm_pid=$!
        xt=""
        for _ in $(seq 150); do
            xt=$(xdotool search --onlyvisible --pid "$xterm_pid" 2> /dev/null | tail -1)
            [ -n "$xt" ] && break
            sleep 0.1
        done
        [ -n "$xt" ] || fail "no xterm window"
        xdotool windowactivate --sync "$xt" 2> /dev/null || true
        active() { xdotool getactivewindow 2> /dev/null; }
        for _ in $(seq 50); do [ "$(active)" = "$xt" ] && break; sleep 0.1; done
        [ "$(active)" = "$xt" ] || fail "the xterm never took focus"
        xdotool key ctrl+alt+space
        hk=""
        for _ in $(seq 80); do
            a=$(active)
            if [ -n "$a" ] && [ "$a" != "$xt" ] && [ "$a" != "$win" ] && [ "$(xdotool getwindowpid "$a" 2> /dev/null)" = "$app_pid" ]; then hk=$a; break; fi
            sleep 0.1
        done
        shoot
        [ -n "$hk" ] || fail "the chord did not bring a hotkey window forward (active is $(active), see $scratch/app.log)"
        xdotool key ctrl+alt+space
        for _ in $(seq 80); do [ "$(active)" = "$xt" ] && break; sleep 0.1; done
        shoot
        [ "$(active)" = "$xt" ] || fail "the second chord did not give focus back to the xterm (active is $(active))"
        xdotool search --onlyvisible --pid "$app_pid" 2> /dev/null | grep -qx "$hk" && fail "the hotkey window is still visible after the second chord"
        # A third press brings it back: the window is only hidden, not gone.
        xdotool key ctrl+alt+space
        for _ in $(seq 80); do [ "$(active)" = "$hk" ] && break; sleep 0.1; done
        [ "$(active)" = "$hk" ] || fail "the third chord did not bring the hotkey window back (active is $(active))"
        ;;
    host)
        sleep 1
        type_pid_line
        shoot
        shell_pid=$(head -1 "$scratch/pids")
        parent=$(ps -o ppid= -p "$shell_pid" | tr -d ' ')
        [ -n "$parent" ] || fail "no parent for the pane's shell $shell_pid"
        parent_name=$(ps -o comm= -p "$parent")
        [ "$parent_name" = termurion-host ] || fail "the pane's shell runs under '$parent_name', not termurion-host"
        # A host that did not start shows the "Shells run inside Termurion" banner and runs the shell
        # under the app instead, so the parent above is the proof; the banner itself is UI only.
        ;;
    layout)
        sleep 1
        type_pid_line
        # New tab (Cmd+T, newSession:), then Split Vertically (Cmd+D, splitVertically:).
        xdotool key ctrl+shift+t
        sleep 1.5
        type_pid_line
        xdotool key ctrl+shift+d
        sleep 1.5
        type_pid_line
        shoot
        [ "$(sort -u "$scratch/pids" | wc -l)" -eq 3 ] || fail "expected 3 distinct pids: $(tr '\n' ' ' < "$scratch/pids")"
        ;;
    menubar)
        sleep 1
        # Where the bar's titles and the Shell items are, from the layout code itself.
        layout=$(cargo test --lib print_bar_layout -- --ignored --nocapture 2> /dev/null | sed -n 's/^LAYOUT //p')
        [ -n "$layout" ] || fail "no bar layout from the print_bar_layout test"
        at() { echo "$layout" | awk -v k="$1" -v n="$2" '$0 ~ "^"k" "n" [0-9]+ [0-9]+$" { print $(NF-1), $NF }'; }
        eval "$(xdotool getwindowgeometry --shell "$win")"
        click_at() {
            local x y
            read -r x y <<< "$(at "$1" "$2")"
            [ -n "$x" ] || fail "no layout for $1 $2"
            xdotool mousemove $((X + x)) $((Y + y))
            sleep 0.2
            xdotool click 1
            sleep 0.6
        }
        # A click on View, then away from it, must not select in the pane: rows of text, a drag that
        # selects (the control), another program taking the primary selection, then the View click and
        # a drag that starts outside the open menu. The primary selection must still be the other program's.
        xdotool type --delay 20 "printf '\\033[2J\\033[H'; for i in \$(seq 20); do echo SELECTME; done; cat > /dev/null"
        xdotool key Return
        sleep 1
        xdotool mousemove $((X + 2)) $((Y + 60))
        xdotool mousedown 1
        for x in 60 120 200 300; do xdotool mousemove $((X + x)) $((Y + 60)); sleep 0.1; done
        xdotool mouseup 1
        sleep 0.6
        shoot
        got=$(timeout 5 "$xclip_bin" -o -selection primary 2> /dev/null | tr -d '\n' | sed 's/ *$//')
        case "$got" in *SELECTME*) ;; *) fail "the control drag selected '$got'" ;; esac
        printf other | "$xclip_bin" -quiet -selection primary > /dev/null 2>&1 &
        xclip_pid=$!
        sleep 0.6
        click_at title View
        shoot
        xdotool mousemove $((X + 2)) $((Y + 60))
        xdotool mousedown 1
        for x in 60 120 200 300; do xdotool mousemove $((X + x)) $((Y + 60)); sleep 0.1; done
        xdotool mouseup 1
        sleep 0.6
        got=$(timeout 5 "$xclip_bin" -o -selection primary 2> /dev/null | tr -d '\n' | sed 's/ *$//')
        kill "$xclip_pid" 2> /dev/null
        [ "$got" = other ] || fail "a click away from the open View menu reached the pane: the selection is '$got'"
        xdotool key ctrl+d
        sleep 0.5
        # The menu as the way to a tab and a split.
        type_pid_line
        click_at title Shell
        click_at row "New Tab"
        sleep 1
        type_pid_line
        click_at title Shell
        click_at row "Split Vertically with Current Profile"
        sleep 1
        type_pid_line
        shoot
        [ "$(sort -u "$scratch/pids" | wc -l)" -eq 3 ] || fail "expected 3 distinct pids: $(tr '\n' ' ' < "$scratch/pids")"
        ;;
    popup)
        sleep 1
        # A word in the pane, selected by a double click; a right click opens the pane's pop-up (drawn
        # in the window); a click on its Copy row puts the word on the clipboard.
        word=POPUPWORDX
        xdotool type --delay 20 "printf '\\033[2J\\033[H'; echo $word; cat > /dev/null"
        xdotool key Return
        sleep 1
        eval "$(xdotool getwindowgeometry --shell "$win")"
        # The word sits on the first text row under the bar (about 36 px down); try a few y values until the
        # double click makes the primary selection the word.
        px=40 py=""
        for y in 36 32 40 44 30; do
            xdotool mousemove $((X + px)) $((Y + y))
            sleep 0.2
            xdotool click --repeat 2 --delay 80 1
            sleep 0.6
            got=$(timeout 5 "$xclip_bin" -o -selection primary 2> /dev/null | tr -d '\n' | sed 's/ *$//')
            if [ "$got" = "$word" ]; then py=$y; break; fi
        done
        [ -n "$py" ] || { shoot; fail "the double click never selected $word (primary is '$got')"; }
        # Selecting copies to the clipboard by itself, so a stale value goes there now: only the
        # pop-up's Copy can put the word back.
        printf stale | "$xclip_bin" -quiet -selection clipboard > /dev/null 2>&1 &
        stale_pid=$!
        sleep 0.5
        before="$scratch/before.png"
        import -window root "$before" 2> /dev/null
        xdotool click 3
        sleep 1
        shoot
        cp "$scratch/screen.png" "$scratch/popup-open.png"
        # The pop-up is in the picture: a good part of the area right of and below the pointer changed.
        changed=$(compare -metric AE -crop 300x400+$((X + px))+$((Y + py)) "$before" "$scratch/screen.png" null: 2>&1 || true)
        [ "${changed:-0}" -gt 5000 ] 2> /dev/null || fail "no pop-up in the screenshot: $changed pixels changed (see $scratch/screen.png)"
        # Where its Copy row is, from the layout code (the pop-up opens at the pointer, window points).
        layout=$(WORD=$word W=$WIDTH H=$HEIGHT PX=$px PY=$py cargo test --lib print_popup_layout -- --ignored --nocapture 2> /dev/null | sed -n 's/^LAYOUT popup Copy //p')
        [ -n "$layout" ] || fail "no pop-up layout from the print_popup_layout test"
        read -r cx cy <<< "$layout"
        xdotool mousemove $((X + cx)) $((Y + cy))
        sleep 0.3
        xdotool click 1
        sleep 1
        shoot
        got=$(timeout 5 "$xclip_bin" -o -selection clipboard 2> /dev/null | tr -d '\n')
        kill "$stale_pid" 2> /dev/null
        # And the pop-up is gone after the pick: the area is back to the shot before the right click
        # (the selection was already in it; a little room for the cursor and anti-aliasing).
        gone=$(compare -metric AE -fuzz 10% -crop 300x400+$((X + px))+$((Y + py)) "$before" "$scratch/screen.png" null: 2>&1 || true)
        [ "${gone:-99999}" -lt 1500 ] 2> /dev/null || fail "the area is not back to what it was before the pop-up: $gone pixels differ (see $scratch/screen.png)"
        [ "$got" = "$word" ] || fail "Copy in the pop-up left '$got' on the clipboard, not $word (see $scratch/screen.png)"
        ;;
    job)
        sleep 1
        # A second tab, so the close below is not the window's last. Its shell runs `sleep 20`.
        xdotool key ctrl+shift+t
        sleep 1.5
        type_pid_line
        shell_pid=$(tail -1 "$scratch/pids")
        xdotool type --delay 20 'sleep 20'
        xdotool key Return
        # The job watcher looks every half second; the title is the job's name.
        title=""
        for _ in $(seq 40); do
            title=$(xdotool getwindowname "$win" 2> /dev/null)
            case "$title" in *sleep*) break ;; esac
            sleep 0.25
        done
        case "$title" in *sleep*) ;; *) fail "the title never read sleep: '$title'" ;; esac
        # Close Session (Cmd+W, closeCurrentSession:) must ask. The question goes to stderr as well
        # as into a window (zenity), and the window waits for an answer, so the shell outlives the key.
        xdotool key ctrl+shift+w
        for _ in $(seq 40); do
            grep -q "is running sleep" "$scratch/app.log" && break
            sleep 0.25
        done
        grep -q "is running sleep" "$scratch/app.log" || fail "the close never asked about the sleep (see $scratch/app.log)"
        # The box is zenity, the app's child. Its X window must exist within 10 s; only then the shot.
        # (zenity 4 under Xvfb with no window manager creates it but never maps it, so the shot shows
        # the app dimmed behind it and not the box itself.)
        for _ in $(seq 40); do
            zenity_pid=$(pgrep -P "$app_pid" -x zenity | head -1)
            [ -n "$zenity_pid" ] && [ -n "$(xdotool search --pid "$zenity_pid" 2> /dev/null | head -1)" ] && break
            sleep 0.25
        done
        [ -n "$zenity_pid" ] || fail "no question box was started (see $scratch/app.log)"
        [ -n "$(xdotool search --pid "$zenity_pid" 2> /dev/null | head -1)" ] || fail "the question window never appeared"
        sleep 0.5
        shoot
        kill -0 "$shell_pid" 2> /dev/null || fail "the close did not wait for an answer: the shell $shell_pid is gone"
        pgrep -P "$shell_pid" -x sleep > /dev/null || fail "the sleep under $shell_pid is gone"
        ;;
    restore-windows | restore-host)
        sleep 1
        # Three panes: tab one, then a second tab split in two. Each writes MARK-<pid> and its pid.
        type_mark() {
            xdotool type --delay 20 'echo MARK-$$; echo $$ >> "$SCRATCH/pids"'
            xdotool key Return
            want=$((want + 1))
            for _ in $(seq 100); do
                [ "$(wc -l < "$scratch/pids")" -ge "$want" ] && return 0
                sleep 0.1
            done
            fail "pane $want never wrote its pid (see $scratch/screen.png)"
        }
        type_mark
        xdotool key ctrl+shift+t
        sleep 1.5
        type_mark
        xdotool key ctrl+shift+d
        sleep 1.5
        type_mark
        shoot
        [ "$(sort -u "$scratch/pids" | wc -l)" -eq 3 ] || fail "expected 3 distinct pids: $(tr '\n' ' ' < "$scratch/pids")"
        cp "$scratch/pids" "$scratch/pids1"
        cp "$scratch/screen.png" "$scratch/before.png"
        touch "$scratch/typed"
        state="$scratch/home/.config/termurion/state"
        # After the restart, prove the shape with the next-pane and next-tab chords (Cmd+] and
        # Cmd+Shift+], pressed as ctrl+shift+} and ctrl+alt+shift+}): two tabs, the first a single pane,
        # the second split in two. Each pane answers with its pid; the answers must show that shape.
        say() {
            local n
            n=$(wc -l < "$scratch/pids")
            xdotool type --delay 20 'echo $$ >> "$SCRATCH/pids"'
            xdotool key Return
            for _ in $(seq 50); do
                [ "$(wc -l < "$scratch/pids")" -gt "$n" ] && break
                sleep 0.1
            done
            [ "$(wc -l < "$scratch/pids")" -gt "$n" ] || return 1
            tail -1 "$scratch/pids"
        }
        next_pane() { xdotool key ctrl+shift+braceright; sleep 1; }
        next_tab() { xdotool key ctrl+alt+shift+braceright; sleep 1; }
        reach_shape() {
            : > "$scratch/pids"
            sleep 3
            local a1 a2 b1 b2 b3 c1 c2
            # The restored tab: one pane or two, told by whether the next pane is another shell.
            a1=$(say) || return 1; next_pane; a2=$(say) || return 1
            next_tab; b1=$(say) || return 1; next_pane; b2=$(say) || return 1
            next_pane; b3=$(say) || return 1
            if [ "$a1" = "$a2" ]; then single=$a1; pair1=$b1; pair2=$b2; back=$b3; [ "$b1" = "$b3" ] || return 2
            else single=$b1; pair1=$a1; pair2=$a2; [ "$b1" = "$b2" ] || return 3; [ "$b1" = "$b3" ] || return 3; fi
            [ "$pair1" != "$pair2" ] && [ "$single" != "$pair1" ] && [ "$single" != "$pair2" ] || return 4
            # Two tabs only: the next tab from here is the first one again.
            next_tab; c1=$(say) || return 1; next_tab; c2=$(say) || return 1
            [ "$c1" != "$c2" ] || return 5
            return 0
        }
        if [ "$scenario" = restore-windows ]; then
            # Quit Termurion (Cmd+Q, terminate:); a question about it is answered OK.
            xdotool key ctrl+shift+q
            # The quit question is answered by the stand-in zenity on PATH (it exits 0, as OK does).
            for _ in $(seq 50); do kill -0 "$app_pid" 2> /dev/null || break; sleep 0.2; done
            kill -0 "$app_pid" 2> /dev/null && fail "the app did not quit (see $scratch/app.log)"
            [ -s "$state" ] || fail "no saved windows file at $state after the quit"
            for pid in $(cat "$scratch/pids1"); do
                grep -aq "MARK-$pid" "$state" || fail "the saved windows hold no MARK-$pid line"
            done
            launch_app
            find_window
        else
            for pid in $(cat "$scratch/pids1"); do kill -0 "$pid" 2> /dev/null || fail "shell $pid is gone before the crash"; done
            # The app saves its windows QUIET after the last change and at most every FLOOR (restore_state.rs):
            # wait for a save newer than the last typing, for at most both plus a margin.
            quiet=$(sed -n 's/^pub const QUIET: Duration = Duration::from_secs(\([0-9]*\));/\1/p' src/restore_state.rs)
            floor=$(sed -n 's/^pub const FLOOR: Duration = Duration::from_secs(\([0-9]*\));/\1/p' src/restore_state.rs)
            [ -n "$quiet" ] && [ -n "$floor" ] || fail "could not read QUIET and FLOOR from src/restore_state.rs"
            deadline=$(( $(date +%s) + quiet + floor + 10 ))
            until [ "$state" -nt "$scratch/typed" ]; do
                [ "$(date +%s)" -lt "$deadline" ] || fail "the app never saved its windows after the typing"
                sleep 0.5
            done
            old_app=$app_pid
            kill -9 "$old_app"
            sleep 1
            for pid in $(cat "$scratch/pids1"); do kill -0 "$pid" 2> /dev/null || fail "shell $pid died with the app"; done
            # The host watches for the app and starts it again by itself.
            app_pid=""
            deadline=$(( $(date +%s) + 15 ))
            while [ "$(date +%s)" -lt "$deadline" ]; do
                for p in /proc/[0-9]*; do
                    [ "$(cat "$p/comm" 2> /dev/null)" = termurion ] || continue
                    [ "${p#/proc/}" = "$old_app" ] && continue
                    tr '\0' '\n' < "$p/environ" 2> /dev/null | grep -qx "XDG_RUNTIME_DIR=$scratch/run" || continue
                    app_pid=${p#/proc/}
                done
                [ -n "$app_pid" ] && break
                sleep 0.2
            done
            [ -n "$app_pid" ] || fail "the host did not reopen Termurion"
            find_window
        fi
        reach_shape
        rc=$?
        [ "$rc" -eq 0 ] || { shoot; fail "the restored layout is not two tabs (one pane, then a split pair): step $rc, pids $(tr '\n' ' ' < "$scratch/pids") (see $scratch/screen.png)"; }
        shoot
        cp "$scratch/pids" "$scratch/pids2"
        if [ "$scenario" = restore-host ]; then
            [ "$single" = "$(sed -n 1p "$scratch/pids1")" ] || fail "the single-pane tab holds $single, not the first shell $(sed -n 1p "$scratch/pids1")"
            [ "$(printf '%s\n%s\n' "$pair1" "$pair2" | sort)" = "$(sed -n '2,3p' "$scratch/pids1" | sort)" ] || fail "the split tab holds $pair1 and $pair2, not the second and third shells"
            [ "$(sort -u "$scratch/pids1")" = "$(sort -u "$scratch/pids2")" ] || fail "pids2 ($(sort -u "$scratch/pids2" | tr '\n' ' ')) is not pids1 ($(sort -u "$scratch/pids1" | tr '\n' ' '))"
        else
            [ -z "$(sort -u "$scratch/pids1" "$scratch/pids2" | uniq -d)" ] || fail "a restored pane kept an old shell pid"
        fi
        ;;
    alert)
        title='Check for updates automatically?'
        # The text it opens with: window_height() of the question's text (src/prompt_ui.rs) is at least 130.
        created=130
        if $wayland; then
            # Its toplevel (by title), then its xdg_surface (the one that made that toplevel).
            top="" surf=""
            for _ in $(seq 100); do
                top=$(grep -a "set_title(\"$title\")" "$scratch/app.log" 2> /dev/null | head -1 | sed -n 's/.*-> xdg_toplevel[#@]\([0-9]*\)\.set_title.*/\1/p')
                [ -n "$top" ] && break
                sleep 0.1
            done
            [ -n "$top" ] || fail "the alert never opened (no set_title \"$title\" in $scratch/app.log)"
            surf=$(grep -a "get_toplevel(new id xdg_toplevel[#@]$top)" "$scratch/app.log" | head -1 | sed -n 's/.*-> xdg_surface[#@]\([0-9]*\)\.get_toplevel.*/\1/p')
            sleep 4
            shoot
            grep -a -e "xdg_surface[#@]$surf\.set_window_geometry" -e "xdg_toplevel[#@]$top\.configure(" -e "xdg_toplevel[#@]$top\.set_m" "$scratch/app.log" > "$scratch/alert-wayland.log"
            # The height the window has at each drawn frame: the geometry in force when a buffer is
            # committed (a geometry set before the first buffer never shows).
            ws=$(grep -a "get_xdg_surface(new id xdg_surface[#@]$surf," "$scratch/app.log" | head -1 | sed -n 's/.*wl_surface[#@]\([0-9]*\)).*/\1/p')
            heights=$(awk -v s="$surf" -v w="$ws" '
                $0 ~ "xdg_surface[#@]" s "\\.set_window_geometry\\(" { g = $0; sub(/.*set_window_geometry\(0, 0, [0-9]+, /, "", g); sub(/\).*/, "", g); h = g }
                $0 ~ "wl_surface[#@]" w "\\.attach\\(" { att = 1 }
                $0 ~ "wl_surface[#@]" w "\\.commit\\(" && att { print h; att = 0 }' "$scratch/app.log" | sort -u)
            [ -n "$heights" ] || fail "the alert never drew a frame with a geometry (see $scratch/alert-wayland.log)"
            [ "$(echo "$heights" | wc -l)" -eq 1 ] || fail "the alert was mapped at one height and changed after: $(echo $heights) (see $scratch/alert-wayland.log)"
            [ "$heights" -lt "$created" ] || fail "the alert kept its creation height $heights"
            others=$(grep -a "xdg_toplevel[#@]$top\.configure(" "$scratch/app.log" | sed -n 's/.*configure([0-9]*, \([0-9]*\),.*/\1/p' | grep -vx -e 0 -e "$heights" | head -1)
            [ -z "$others" ] || fail "weston configured the alert at $others, not its $heights (see $scratch/alert-wayland.log)"
            echo "alert wayland: every drawn frame at height $heights; configures: $(grep -a "xdg_toplevel[#@]$top\.configure(" "$scratch/app.log" | sed -n 's/.*configure(\([^)]*\)).*/(\1)/p' | tr '\n' ' ')"
        else
            alert=""
            for _ in $(seq 100); do
                alert=$(xdotool search --onlyvisible --name "Check for updates automatically" 2> /dev/null | head -1)
                [ -n "$alert" ] && break
                sleep 0.1
            done
            [ -n "$alert" ] || fail "the alert never showed"
            h1=$(xwininfo -id "$alert" | sed -n 's/^ *Height: //p')
            sleep 3
            h2=$(xwininfo -id "$alert" | sed -n 's/^ *Height: //p')
            shoot
            [ "$h1" = "$h2" ] || fail "the alert showed at $h1 and changed to $h2"
            [ "$h1" -lt "$created" ] || fail "the alert kept its creation height $h1"
            echo "alert x11: shown at height $h1, still $h2 three seconds later"
        fi
        ;;
    paste)
        sleep 1
        # Pane one shows the word alone on row 0; a split makes pane two, which writes what it reads to a file.
        word=PASTEWORDX
        xdotool type --delay 20 "printf '\\033[2J\\033[H$word\\n'; cat > /dev/null"
        xdotool key Return
        sleep 1
        xdotool key ctrl+shift+d
        sleep 3
        xdotool type --delay 20 "cat > \"\$SCRATCH/pasted\""
        xdotool key Return
        sleep 1
        # A double click on the word selects it (and focuses pane one); Copy puts it on the clipboard.
        # With two panes each has a title row, so the word's row is about 58 px down; on weston the
        # window is full screen, which has no menu bar, so 24 px less.
        eval "$(xdotool getwindowgeometry --shell "$win")"
        wy=58
        $wayland && wy=34
        xdotool mousemove $((X + 40)) $((Y + wy))
        sleep 0.2
        xdotool click --repeat 2 --delay 80 1
        sleep 0.6
        xdotool key ctrl+shift+c
        sleep 0.6
        shoot
        cp "$scratch/screen.png" "$scratch/copied.png"
        # To pane two (Cmd+], next pane) and Paste, then end the cat.
        xdotool key ctrl+shift+braceright
        sleep 1
        xdotool key ctrl+shift+v
        sleep 1
        xdotool key Return
        xdotool key ctrl+d
        for _ in $(seq 50); do [ -s "$scratch/pasted" ] && break; sleep 0.1; done
        shoot
        [ "$(tr -d '\n' < "$scratch/pasted" 2> /dev/null)" = "$word" ] || fail "Copy then Paste gave '$(cat "$scratch/pasted" 2> /dev/null)', not $word (see $scratch/copied.png, $scratch/screen.png)"
        ;;
    clipboard)
        sleep 1
        # Draw the word alone on row 0 (a screen clear without the scrollback one that asks a question),
        # then start a cat that writes a file, so nothing touches the screen after the drag below.
        xdotool type --delay 20 "printf '\\033[2J\\033[HSELECTME\\n'; cat > \"\$SCRATCH/got\""
        xdotool key Return
        sleep 1
        # A drag along row 0 (under the menu bar) selects the line; the primary selection must then hold the word.
        eval "$(xdotool getwindowgeometry --shell "$win")"
        xdotool mousemove $((X + 2)) $((Y + 36))
        xdotool mousedown 1
        for x in 60 120 200 300; do xdotool mousemove $((X + x)) $((Y + 36)); sleep 0.1; done
        xdotool mouseup 1
        sleep 1
        shoot
        got=$(timeout 5 "$xclip_bin" -o -selection primary 2> /dev/null | tr -d '\n' | sed 's/ *$//')
        [ "$got" = SELECTME ] || fail "the primary selection after a drag is '$got', not SELECTME"
        # Another program owns the selection now, while the drag's highlight stays in the pane: a
        # middle click pastes what the primary selection holds now, not the pane's old text.
        printf other | "$xclip_bin" -quiet -selection primary > /dev/null 2>&1 &
        xclip_pid=$!
        sleep 1
        xdotool mousemove $((X + 600)) $((Y + 300))
        xdotool click 2
        sleep 1
        xdotool key Return
        xdotool key ctrl+d
        for _ in $(seq 50); do [ -s "$scratch/got" ] && break; sleep 0.1; done
        shoot
        kill "$xclip_pid" 2> /dev/null
        [ "$(tr -d '\n' < "$scratch/got" 2> /dev/null)" = other ] || fail "the middle click did not paste 'other' (got '$(cat "$scratch/got" 2> /dev/null)')"
        ;;
    tmux-restore)
        sleep 1
        xdotool type --delay 20 'tmux -L guicheck -f /dev/null -CC new-session -s gui'
        xdotool key Return
        mode=""
        for _ in $(seq 100); do
            mode=$(tmux -L guicheck list-clients -F '#{client_control_mode}' 2> /dev/null | head -1)
            [ "$mode" = 1 ] && break
            sleep 0.1
        done
        [ "$mode" = 1 ] || fail "no control mode client on the guicheck server before the relaunch (client_control_mode '$mode')"
        sleep 3
        touch "$scratch/typed"
        state="$scratch/home/.config/termurion/state"
        if [ "$variant" = a ]; then
            xdotool key ctrl+shift+q
            for _ in $(seq 50); do kill -0 "$app_pid" 2> /dev/null || break; sleep 0.2; done
            kill -0 "$app_pid" 2> /dev/null && fail "the app did not quit (see $scratch/app.log)"
            [ -s "$state" ] || fail "no saved windows file at $state after the quit"
            lines_before=$(wc -l < "$scratch/app.log")
            launch_app
            find_window
        else
            quiet=$(sed -n 's/^pub const QUIET: Duration = Duration::from_secs(\([0-9]*\));/\1/p' src/restore_state.rs)
            floor=$(sed -n 's/^pub const FLOOR: Duration = Duration::from_secs(\([0-9]*\));/\1/p' src/restore_state.rs)
            deadline=$(( $(date +%s) + quiet + floor + 10 ))
            until [ "$state" -nt "$scratch/typed" ]; do
                [ "$(date +%s)" -lt "$deadline" ] || fail "the app never saved its windows"
                sleep 0.5
            done
            old_app=$app_pid
            lines_before=$(wc -l < "$scratch/app.log")
            [ "$variant" = d ] && { tmux -L guicheck new-window -d; sleep 0.05; }
            kill -9 "$old_app"
            [ "$variant" = c ] && tmux -L guicheck kill-server 2> /dev/null
            app_pid=""
            deadline=$(( $(date +%s) + 20 ))
            while [ "$(date +%s)" -lt "$deadline" ]; do
                for p in /proc/[0-9]*; do
                    [ "$(cat "$p/comm" 2> /dev/null)" = termurion ] || continue
                    [ "${p#/proc/}" = "$old_app" ] && continue
                    tr '\0' '\n' < "$p/environ" 2> /dev/null | grep -qx "XDG_RUNTIME_DIR=$scratch/run" || continue
                    app_pid=${p#/proc/}
                done
                [ -n "$app_pid" ] && break
                sleep 0.2
            done
            [ -n "$app_pid" ] || fail "the host did not reopen Termurion"
            find_window
        fi
        sleep 5
        shoot
        # The error box prints its title and text to the app log (stderr) and the stand-in zenity log.
        if tail -n +$((lines_before + 1)) "$scratch/app.log" | grep -q "Reported a Problem" || grep -qs "Reported a Problem" "$scratch/zenity.log"; then
            fail "the relaunch raised 'tmux Reported a Problem': $(tail -n +$((lines_before + 1)) "$scratch/app.log" | grep -m1 'Reported a Problem') (see $scratch/screen.png)"
        fi
        mode=$(tmux -L guicheck list-clients -F '#{client_control_mode}' 2> /dev/null | head -1)
        echo "tmux-restore $variant: client_control_mode '${mode:-none}' after the relaunch"
        # Either tmux mode is back (mode 1) or the pane is a plain shell that answers a typed line.
        : > "$scratch/pids"; want=0
        type_pid_line
        shoot
        cp "$scratch/pids" "$scratch/pids2"
        ;;
    tmux | tmux-nolang | tmux-lcall | tmux-windows)
        sleep 1
        windows_before=$(xdotool search --onlyvisible --pid "$app_pid" 2> /dev/null | wc -l)
        # Control mode: the app drives the pane, and its first tmux window opens as a tab or a window.
        xdotool type --delay 20 'tmux -L guicheck -f /dev/null -CC new-session -s gui'
        xdotool key Return
        mode=""
        for _ in $(seq 100); do
            mode=$(tmux -L guicheck list-clients -F '#{client_control_mode}' 2> /dev/null | head -1)
            [ "$mode" = 1 ] && break
            sleep 0.1
        done
        [ "$mode" = 1 ] || fail "no control mode client on the guicheck server (client_control_mode '$mode')"
        sleep 3
        shoot
        if [ "$scenario" = tmux-windows ]; then
            # The default opens the tmux window as a window of its own: a second visible X window.
            windows_after=$(xdotool search --onlyvisible --pid "$app_pid" 2> /dev/null | wc -l)
            [ "$windows_after" -gt "$windows_before" ] || fail "no new Termurion window opened ($windows_before before, $windows_after after)"
            newwin=$(xdotool search --onlyvisible --pid "$app_pid" 2> /dev/null | grep -vx "$win" | tail -1)
            xdotool windowfocus --sync "$newwin" 2> /dev/null || true
            sleep 1
        fi
        type_pid_line
        shoot
        shell_pid=$(head -1 "$scratch/pids")
        server_pid=$(tmux -L guicheck display-message -p '#{pid}' 2> /dev/null)
        parent=$(ps -o ppid= -p "$shell_pid" | tr -d ' ')
        [ -n "$server_pid" ] && [ "$parent" = "$server_pid" ] || fail "the shell $shell_pid has parent '$parent', not the tmux server '$server_pid' (see $scratch/screen.png)"
        # The pid line came from a tmux pane (the new tab or window), not from the gateway's own shell.
        tmux -L guicheck list-panes -a -F '#{pane_pid}' | grep -qx "$shell_pid" || fail "pid $shell_pid is not the shell of a tmux pane"
        ;;
esac
kill -0 "$app_pid" 2> /dev/null || fail "the app died (see $scratch/app.log)"
# Settings and data land where the OS says, never in the temp folder.
[ -f "$scratch/home/.config/termurion/settings.toml" ] || fail "no settings.toml under \$HOME/.config/termurion"
[ ! -e "$scratch/tmp/Termurion" ] && [ ! -e "$scratch/tmp/termurion" ] || fail "the app wrote its folder into the temp folder"
echo "PASS $scenario"
