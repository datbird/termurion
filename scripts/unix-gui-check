#!/usr/bin/env bash
# Drives the real Termurion window on a private X server and says PASS or FAIL for one scenario.
# Usage: scripts/unix-gui-check <scenario>      scenarios: shell, layout, host, job
#
# Needs Xvfb, xdotool and ImageMagick's import. Proof is a file, not pixels: each pane runs
# `echo $$ >> $SCRATCH/pids`, and a screenshot (screen.png) is kept for a person to look at.
# The app runs with HOME, TMPDIR and XDG_RUNTIME_DIR under target/gui-check/<scenario>/.
# Keys go through XTEST (xdotool type/key, never --window), with no window manager, so the
# window is focused by hand. No chord uses the Super key: Command is Ctrl+Shift (shortcut_key.rs),
# so New Tab (newSession:, Cmd+T) is ctrl+shift+t and Split Vertically (splitVertically:, Cmd+D)
# is ctrl+shift+d.
set -uo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo"
scenario="${1:-}"
case "$scenario" in
    shell | layout | host | job) ;;
    *) echo "usage: scripts/unix-gui-check <shell|layout|host|job>" >&2; exit 2 ;;
esac
for tool in Xvfb xdotool import; do
    command -v "$tool" > /dev/null || { echo "FAIL $scenario: $tool is not installed"; exit 1; }
done
# shellcheck disable=SC1090
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

display=:97
scratch="$repo/target/gui-check/$scenario"
rm -rf "$scratch"
mkdir -p "$scratch/home" "$scratch/tmp" "$scratch/run"
chmod 700 "$scratch/run"
: > "$scratch/pids"

xvfb_pid="" app_pid=""
cleanup() {
    [ -n "$app_pid" ] && kill "$app_pid" 2> /dev/null
    # A session host this run started holds this scratch XDG_RUNTIME_DIR in its environment.
    for p in /proc/[0-9]*; do
        [ -r "$p/comm" ] && [ "$(cat "$p/comm" 2> /dev/null)" = termurion-host ] \
            && tr '\0' '\n' < "$p/environ" 2> /dev/null | grep -qx "XDG_RUNTIME_DIR=$scratch/run" \
            && kill "${p#/proc/}" 2> /dev/null
    done
    [ -n "$xvfb_pid" ] && kill "$xvfb_pid" 2> /dev/null
    return 0
}
trap cleanup EXIT
fail() { echo "FAIL $scenario: $1"; exit 1; }

cargo build --bins > "$scratch/build.log" 2>&1 || { tail -5 "$scratch/build.log" >&2; fail "cargo build --bins"; }

Xvfb "$display" -screen 0 1600x1000x24 -nolisten tcp > "$scratch/xvfb.log" 2>&1 &
xvfb_pid=$!
for _ in $(seq 50); do [ -S "/tmp/.X11-unix/X${display#:}" ] && break; sleep 0.1; done
[ -S "/tmp/.X11-unix/X${display#:}" ] || fail "Xvfb did not start"

export DISPLAY="$display" SCRATCH="$scratch" SHELL=/bin/bash
# The host scenario runs its shells in termurion-host (the setting is read at startup).
if [ "$scenario" = host ]; then
    mkdir -p "$scratch/home/.config/termurion"
    printf '[settings]\nRunJobsInServers = true\n' > "$scratch/home/.config/termurion/settings.toml"
fi
# The job scenario's profile asks before closing a session that runs a job (a new profile never asks).
if [ "$scenario" = job ]; then
    mkdir -p "$scratch/home/.config/termurion"
    printf 'default = "job-check"\n\n[[profile]]\nGuid = "job-check"\nName = "Default"\n"Prompt Before Closing 2" = 2\n' > "$scratch/home/.config/termurion/profiles.toml"
fi
env -u TMUX -u WAYLAND_DISPLAY -u XDG_CONFIG_HOME -u XDG_STATE_HOME HOME="$scratch/home" TMPDIR="$scratch/tmp" XDG_RUNTIME_DIR="$scratch/run" \
    "$repo/target/debug/termurion" > "$scratch/app.log" 2>&1 &
app_pid=$!

win=$(timeout 30 xdotool search --sync --onlyvisible --pid "$app_pid" 2> /dev/null | tail -1)
[ -n "$win" ] || fail "no window for pid $app_pid (see $scratch/app.log)"
xdotool windowfocus --sync "$win" 2> /dev/null || true
sleep 2

# Types the pid line into whichever pane has focus, then waits for it to land in the file.
want=0
type_pid_line() {
    xdotool type --delay 20 'echo $$ >> "$SCRATCH/pids"'
    xdotool key Return
    want=$((want + 1))
    for _ in $(seq 100); do
        [ "$(wc -l < "$scratch/pids")" -ge "$want" ] && return 0
        sleep 0.1
    done
    fail "pane $want never wrote its pid (see $scratch/screen.png)"
}
shoot() { import -window root "$scratch/screen.png" 2> /dev/null || true; }

case "$scenario" in
    shell)
        sleep 1
        type_pid_line
        shoot
        [ "$(sort -u "$scratch/pids" | wc -l)" -eq 1 ] || fail "expected one pid: $(tr '\n' ' ' < "$scratch/pids")"
        ;;
    host)
        sleep 1
        type_pid_line
        shoot
        shell_pid=$(head -1 "$scratch/pids")
        parent=$(ps -o ppid= -p "$shell_pid" | tr -d ' ')
        [ -n "$parent" ] || fail "no parent for the pane's shell $shell_pid"
        parent_name=$(ps -o comm= -p "$parent")
        [ "$parent_name" = termurion-host ] || fail "the pane's shell runs under '$parent_name', not termurion-host"
        # A host that did not start shows the "Shells run inside Termurion" banner and runs the shell
        # under the app instead, so the parent above is the proof; the banner itself is UI only.
        ;;
    layout)
        sleep 1
        type_pid_line
        # New tab (Cmd+T, newSession:), then Split Vertically (Cmd+D, splitVertically:).
        xdotool key ctrl+shift+t
        sleep 1.5
        type_pid_line
        xdotool key ctrl+shift+d
        sleep 1.5
        type_pid_line
        shoot
        [ "$(sort -u "$scratch/pids" | wc -l)" -eq 3 ] || fail "expected 3 distinct pids: $(tr '\n' ' ' < "$scratch/pids")"
        ;;
    job)
        sleep 1
        # A second tab, so the close below is not the window's last. Its shell runs `sleep 20`.
        xdotool key ctrl+shift+t
        sleep 1.5
        type_pid_line
        shell_pid=$(tail -1 "$scratch/pids")
        xdotool type --delay 20 'sleep 20'
        xdotool key Return
        # The job watcher looks every half second; the title is the job's name.
        title=""
        for _ in $(seq 40); do
            title=$(xdotool getwindowname "$win" 2> /dev/null)
            case "$title" in *sleep*) break ;; esac
            sleep 0.25
        done
        case "$title" in *sleep*) ;; *) fail "the title never read sleep: '$title'" ;; esac
        # Close Session (Cmd+W, closeCurrentSession:) must ask. The question goes to stderr as well
        # as into a window (zenity), and the window waits for an answer, so the shell outlives the key.
        xdotool key ctrl+shift+w
        for _ in $(seq 40); do
            grep -q "is running sleep" "$scratch/app.log" && break
            sleep 0.25
        done
        sleep 1
        shoot
        grep -q "is running sleep" "$scratch/app.log" || fail "the close never asked about the sleep (see $scratch/app.log)"
        # The box is zenity, the app's child, waiting for the answer.
        pgrep -P "$app_pid" -x zenity > /dev/null || fail "no question window is open (see $scratch/screen.png)"
        kill -0 "$shell_pid" 2> /dev/null || fail "the close did not wait for an answer: the shell $shell_pid is gone"
        pgrep -P "$shell_pid" -x sleep > /dev/null || fail "the sleep under $shell_pid is gone"
        ;;
esac
kill -0 "$app_pid" 2> /dev/null || fail "the app died (see $scratch/app.log)"
# Settings and data land where the OS says, never in the temp folder.
[ -f "$scratch/home/.config/termurion/settings.toml" ] || fail "no settings.toml under \$HOME/.config/termurion"
[ ! -e "$scratch/tmp/Termurion" ] && [ ! -e "$scratch/tmp/termurion" ] || fail "the app wrote its folder into the temp folder"
echo "PASS $scenario"
