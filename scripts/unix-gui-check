#!/usr/bin/env bash
# Drives the real Termurion window on a private X server and says PASS or FAIL for one scenario.
# Usage: scripts/unix-gui-check <scenario>      scenarios: shell, layout, host, job, clipboard, tmux, tmux-nolang, tmux-lcall, tmux-windows,
# restore-windows, restore-host
#
# Needs Xvfb, xdotool and ImageMagick's import. Proof is a file, not pixels: each pane runs
# `echo $$ >> $SCRATCH/pids`, and a screenshot (screen.png) is kept for a person to look at.
# The app runs with HOME, TMPDIR and XDG_RUNTIME_DIR under target/gui-check/<scenario>/.
# Keys go through XTEST (xdotool type/key, never --window), with no window manager, so the
# window is focused by hand. No chord uses the Super key: Command is Ctrl+Shift (shortcut_key.rs),
# so New Tab (newSession:, Cmd+T) is ctrl+shift+t and Split Vertically (splitVertically:, Cmd+D)
# is ctrl+shift+d.
set -uo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo"
scenario="${1:-}"
case "$scenario" in
    shell | layout | host | job | clipboard | tmux | tmux-nolang | tmux-lcall | tmux-windows | restore-windows | restore-host) ;;
    *) echo "usage: scripts/unix-gui-check <shell|layout|host|job|clipboard|tmux|tmux-nolang|tmux-lcall|tmux-windows|restore-windows|restore-host>" >&2; exit 2 ;;
esac
# The tmux scenarios: tmux (tabs in the attaching window), tmux-nolang (the app starts with no locale
# variable), tmux-lcall (the app starts with LC_ALL=C), tmux-windows (the default: a new Termurion window).
is_tmux=false
case "$scenario" in tmux*) is_tmux=true ;; esac
tools="Xvfb xdotool import"
$is_tmux && tools="$tools tmux"
for tool in $tools; do
    command -v "$tool" > /dev/null || { echo "FAIL $scenario: $tool is not installed"; exit 1; }
done
# xclip may sit in ~/.local/bin, which a non-login shell does not have on PATH.
xclip_bin=$(command -v xclip || true)
[ -z "$xclip_bin" ] && [ -x "$HOME/.local/bin/xclip" ] && xclip_bin="$HOME/.local/bin/xclip"
if [ "$scenario" = clipboard ] && [ -z "$xclip_bin" ]; then
    echo "FAIL $scenario: xclip is not installed"
    exit 1
fi
# shellcheck disable=SC1090
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

display=:97
scratch="$repo/target/gui-check/$scenario"
rm -rf "$scratch"
mkdir -p "$scratch/home" "$scratch/tmp" "$scratch/run"
chmod 700 "$scratch/run"
: > "$scratch/pids"

xvfb_pid="" app_pid="" zenity_pid=""
cleanup() {
    [ -n "$app_pid" ] && kill "$app_pid" 2> /dev/null
    # The job scenario's question box is a child that would outlive the app.
    [ -n "$zenity_pid" ] && kill "$zenity_pid" 2> /dev/null
    # A session host this run started holds this scratch XDG_RUNTIME_DIR in its environment.
    for p in /proc/[0-9]*; do
        [ -r "$p/comm" ] && [ "$(cat "$p/comm" 2> /dev/null)" = termurion-host ] \
            && tr '\0' '\n' < "$p/environ" 2> /dev/null | grep -qx "XDG_RUNTIME_DIR=$scratch/run" \
            && kill "${p#/proc/}" 2> /dev/null
    done
    # The tmux scenario's server, by its own socket name.
    $is_tmux && tmux -L guicheck kill-server 2> /dev/null
    [ -n "$xvfb_pid" ] && kill "$xvfb_pid" 2> /dev/null
    return 0
}
trap cleanup EXIT
fail() {
    echo "FAIL $scenario: $1"
    # What the guicheck server holds, for a person reading the failure.
    $is_tmux && { tmux -L guicheck list-panes -a -F '#{window_id} #{pane_id} #{pane_pid}' 2> /dev/null; tmux -L guicheck capture-pane -p -t '%0' 2> /dev/null | head -8; }
    exit 1
}

$is_tmux && tmux -L guicheck kill-server 2> /dev/null
cargo build --bins > "$scratch/build.log" 2>&1 || { tail -5 "$scratch/build.log" >&2; fail "cargo build --bins"; }

Xvfb "$display" -screen 0 1600x1000x24 -nolisten tcp > "$scratch/xvfb.log" 2>&1 &
xvfb_pid=$!
for _ in $(seq 50); do [ -S "/tmp/.X11-unix/X${display#:}" ] && break; sleep 0.1; done
[ -S "/tmp/.X11-unix/X${display#:}" ] || fail "Xvfb did not start"

export DISPLAY="$display" SCRATCH="$scratch" SHELL=/bin/bash
# The host scenario runs its shells in termurion-host (the setting is read at startup).
if [ "$scenario" = host ] || [ "$scenario" = restore-host ]; then
    mkdir -p "$scratch/home/.config/termurion"
    printf '[settings]\nRunJobsInServers = true\nSUEnableAutomaticChecks = false\n' > "$scratch/home/.config/termurion/settings.toml"
fi
# restore-windows keeps the shells in the app, so a quit ends them and only the saved windows remain.
if [ "$scenario" = restore-windows ]; then
    mkdir -p "$scratch/home/.config/termurion"
    printf '[settings]\nRunJobsInServers = false\nSUEnableAutomaticChecks = false\n' > "$scratch/home/.config/termurion/settings.toml"
fi
# The clipboard scenario binds the middle button to Paste from Selection (the factory binding pastes the clipboard).
if [ "$scenario" = clipboard ]; then
    mkdir -p "$scratch/home/.config/termurion"
    printf '[settings.PointerActions."Button,2,1,,"]\nAction = "kPasteFromSelectionPointerAction"\nArgument = ""\n' > "$scratch/home/.config/termurion/settings.toml"
fi
# The tmux scenario opens tmux windows as tabs of the attaching window (mode 2), so the typing below has a tab to land in.
if [ "$scenario" != tmux-windows ] && $is_tmux; then
    mkdir -p "$scratch/home/.config/termurion"
    printf '[settings]\nOpenTmuxWindowsIn = 2\n' > "$scratch/home/.config/termurion/settings.toml"
fi
# The job scenario's profile asks before closing a session that runs a job (a new profile never asks).
if [ "$scenario" = job ]; then
    mkdir -p "$scratch/home/.config/termurion"
    printf 'default = "job-check"\n\n[[profile]]\nGuid = "job-check"\nName = "Default"\n"Prompt Before Closing 2" = 2\n' > "$scratch/home/.config/termurion/profiles.toml"
fi
# The locale the app itself starts under, for the tmux variants.
locale_env=()
[ "$scenario" = tmux-nolang ] && locale_env=(-u LANG -u LC_ALL -u LC_CTYPE)
[ "$scenario" = tmux-lcall ] && locale_env=(LC_ALL=C)
# A box needs a window manager to be mapped (zenity 4 under bare Xvfb draws nothing), so the quit
# question in restore-windows is answered by a zenity that says OK at once.
if [ "$scenario" = restore-windows ]; then
    mkdir -p "$scratch/bin"
    printf '#!/bin/sh\nexit 0\n' > "$scratch/bin/zenity"
    chmod +x "$scratch/bin/zenity"
    export PATH="$scratch/bin:$PATH"
fi
launch_app() {
    env -u TMUX -u WAYLAND_DISPLAY -u XDG_CONFIG_HOME -u XDG_STATE_HOME "${locale_env[@]}" HOME="$scratch/home" TMPDIR="$scratch/tmp" XDG_RUNTIME_DIR="$scratch/run" \
        "$repo/target/debug/termurion" >> "$scratch/app.log" 2>&1 &
    app_pid=$!
}
# Finds the app's window and focuses it by hand (no window manager).
find_window() {
    win=$(timeout 30 xdotool search --sync --onlyvisible --pid "$app_pid" 2> /dev/null | tail -1)
    [ -n "$win" ] || fail "no window for pid $app_pid (see $scratch/app.log)"
    xdotool windowfocus --sync "$win" 2> /dev/null || true
    sleep 2
}
launch_app
find_window

# Types the pid line into whichever pane has focus, then waits for it to land in the file.
want=0
type_pid_line() {
    xdotool type --delay 20 'echo $$ >> "$SCRATCH/pids"'
    xdotool key Return
    want=$((want + 1))
    for _ in $(seq 100); do
        [ "$(wc -l < "$scratch/pids")" -ge "$want" ] && return 0
        sleep 0.1
    done
    fail "pane $want never wrote its pid (see $scratch/screen.png)"
}
shoot() { import -window root "$scratch/screen.png" 2> /dev/null || true; }

case "$scenario" in
    shell)
        sleep 1
        type_pid_line
        shoot
        [ "$(sort -u "$scratch/pids" | wc -l)" -eq 1 ] || fail "expected one pid: $(tr '\n' ' ' < "$scratch/pids")"
        ;;
    host)
        sleep 1
        type_pid_line
        shoot
        shell_pid=$(head -1 "$scratch/pids")
        parent=$(ps -o ppid= -p "$shell_pid" | tr -d ' ')
        [ -n "$parent" ] || fail "no parent for the pane's shell $shell_pid"
        parent_name=$(ps -o comm= -p "$parent")
        [ "$parent_name" = termurion-host ] || fail "the pane's shell runs under '$parent_name', not termurion-host"
        # A host that did not start shows the "Shells run inside Termurion" banner and runs the shell
        # under the app instead, so the parent above is the proof; the banner itself is UI only.
        ;;
    layout)
        sleep 1
        type_pid_line
        # New tab (Cmd+T, newSession:), then Split Vertically (Cmd+D, splitVertically:).
        xdotool key ctrl+shift+t
        sleep 1.5
        type_pid_line
        xdotool key ctrl+shift+d
        sleep 1.5
        type_pid_line
        shoot
        [ "$(sort -u "$scratch/pids" | wc -l)" -eq 3 ] || fail "expected 3 distinct pids: $(tr '\n' ' ' < "$scratch/pids")"
        ;;
    job)
        sleep 1
        # A second tab, so the close below is not the window's last. Its shell runs `sleep 20`.
        xdotool key ctrl+shift+t
        sleep 1.5
        type_pid_line
        shell_pid=$(tail -1 "$scratch/pids")
        xdotool type --delay 20 'sleep 20'
        xdotool key Return
        # The job watcher looks every half second; the title is the job's name.
        title=""
        for _ in $(seq 40); do
            title=$(xdotool getwindowname "$win" 2> /dev/null)
            case "$title" in *sleep*) break ;; esac
            sleep 0.25
        done
        case "$title" in *sleep*) ;; *) fail "the title never read sleep: '$title'" ;; esac
        # Close Session (Cmd+W, closeCurrentSession:) must ask. The question goes to stderr as well
        # as into a window (zenity), and the window waits for an answer, so the shell outlives the key.
        xdotool key ctrl+shift+w
        for _ in $(seq 40); do
            grep -q "is running sleep" "$scratch/app.log" && break
            sleep 0.25
        done
        grep -q "is running sleep" "$scratch/app.log" || fail "the close never asked about the sleep (see $scratch/app.log)"
        # The box is zenity, the app's child. Its X window must exist within 10 s; only then the shot.
        # (zenity 4 under Xvfb with no window manager creates it but never maps it, so the shot shows
        # the app dimmed behind it and not the box itself.)
        for _ in $(seq 40); do
            zenity_pid=$(pgrep -P "$app_pid" -x zenity | head -1)
            [ -n "$zenity_pid" ] && [ -n "$(xdotool search --pid "$zenity_pid" 2> /dev/null | head -1)" ] && break
            sleep 0.25
        done
        [ -n "$zenity_pid" ] || fail "no question box was started (see $scratch/app.log)"
        [ -n "$(xdotool search --pid "$zenity_pid" 2> /dev/null | head -1)" ] || fail "the question window never appeared"
        sleep 0.5
        shoot
        kill -0 "$shell_pid" 2> /dev/null || fail "the close did not wait for an answer: the shell $shell_pid is gone"
        pgrep -P "$shell_pid" -x sleep > /dev/null || fail "the sleep under $shell_pid is gone"
        ;;
    restore-windows | restore-host)
        sleep 1
        # Three panes: tab one, then a second tab split in two. Each writes MARK-<pid> and its pid.
        type_mark() {
            xdotool type --delay 20 'echo MARK-$$; echo $$ >> "$SCRATCH/pids"'
            xdotool key Return
            want=$((want + 1))
            for _ in $(seq 100); do
                [ "$(wc -l < "$scratch/pids")" -ge "$want" ] && return 0
                sleep 0.1
            done
            fail "pane $want never wrote its pid (see $scratch/screen.png)"
        }
        type_mark
        xdotool key ctrl+shift+t
        sleep 1.5
        type_mark
        xdotool key ctrl+shift+d
        sleep 1.5
        type_mark
        shoot
        [ "$(sort -u "$scratch/pids" | wc -l)" -eq 3 ] || fail "expected 3 distinct pids: $(tr '\n' ' ' < "$scratch/pids")"
        cp "$scratch/pids" "$scratch/pids1"
        cp "$scratch/screen.png" "$scratch/before.png"
        touch "$scratch/typed"
        state="$scratch/home/.config/termurion/state"
        # After the restart, prove the shape with the next-pane and next-tab chords (Cmd+] and
        # Cmd+Shift+], pressed as ctrl+shift+} and ctrl+alt+shift+}): two tabs, the first a single pane,
        # the second split in two. Each pane answers with its pid; the answers must show that shape.
        say() {
            local n
            n=$(wc -l < "$scratch/pids")
            xdotool type --delay 20 'echo $$ >> "$SCRATCH/pids"'
            xdotool key Return
            for _ in $(seq 50); do
                [ "$(wc -l < "$scratch/pids")" -gt "$n" ] && break
                sleep 0.1
            done
            [ "$(wc -l < "$scratch/pids")" -gt "$n" ] || return 1
            tail -1 "$scratch/pids"
        }
        next_pane() { xdotool key ctrl+shift+braceright; sleep 1; }
        next_tab() { xdotool key ctrl+alt+shift+braceright; sleep 1; }
        reach_shape() {
            : > "$scratch/pids"
            sleep 3
            local a1 a2 b1 b2 b3 c1 c2
            # The restored tab: one pane or two, told by whether the next pane is another shell.
            a1=$(say) || return 1; next_pane; a2=$(say) || return 1
            next_tab; b1=$(say) || return 1; next_pane; b2=$(say) || return 1
            next_pane; b3=$(say) || return 1
            if [ "$a1" = "$a2" ]; then single=$a1; pair1=$b1; pair2=$b2; back=$b3; [ "$b1" = "$b3" ] || return 2
            else single=$b1; pair1=$a1; pair2=$a2; [ "$b1" = "$b2" ] || return 3; [ "$b1" = "$b3" ] || return 3; fi
            [ "$pair1" != "$pair2" ] && [ "$single" != "$pair1" ] && [ "$single" != "$pair2" ] || return 4
            # Two tabs only: the next tab from here is the first one again.
            next_tab; c1=$(say) || return 1; next_tab; c2=$(say) || return 1
            [ "$c1" != "$c2" ] || return 5
            return 0
        }
        if [ "$scenario" = restore-windows ]; then
            # Quit Termurion (Cmd+Q, terminate:); a question about it is answered OK.
            xdotool key ctrl+shift+q
            # The quit question is answered by the stand-in zenity on PATH (it exits 0, as OK does).
            for _ in $(seq 50); do kill -0 "$app_pid" 2> /dev/null || break; sleep 0.2; done
            kill -0 "$app_pid" 2> /dev/null && fail "the app did not quit (see $scratch/app.log)"
            [ -s "$state" ] || fail "no saved windows file at $state after the quit"
            for pid in $(cat "$scratch/pids1"); do
                grep -aq "MARK-$pid" "$state" || fail "the saved windows hold no MARK-$pid line"
            done
            launch_app
            find_window
        else
            for pid in $(cat "$scratch/pids1"); do kill -0 "$pid" 2> /dev/null || fail "shell $pid is gone before the crash"; done
            # The app saves its windows QUIET after the last change and at most every FLOOR (restore_state.rs):
            # wait for a save newer than the last typing, for at most both plus a margin.
            quiet=$(sed -n 's/^pub const QUIET: Duration = Duration::from_secs(\([0-9]*\));/\1/p' src/restore_state.rs)
            floor=$(sed -n 's/^pub const FLOOR: Duration = Duration::from_secs(\([0-9]*\));/\1/p' src/restore_state.rs)
            [ -n "$quiet" ] && [ -n "$floor" ] || fail "could not read QUIET and FLOOR from src/restore_state.rs"
            deadline=$(( $(date +%s) + quiet + floor + 10 ))
            until [ "$state" -nt "$scratch/typed" ]; do
                [ "$(date +%s)" -lt "$deadline" ] || fail "the app never saved its windows after the typing"
                sleep 0.5
            done
            old_app=$app_pid
            kill -9 "$old_app"
            sleep 1
            for pid in $(cat "$scratch/pids1"); do kill -0 "$pid" 2> /dev/null || fail "shell $pid died with the app"; done
            # The host watches for the app and starts it again by itself.
            app_pid=""
            deadline=$(( $(date +%s) + 15 ))
            while [ "$(date +%s)" -lt "$deadline" ]; do
                for p in /proc/[0-9]*; do
                    [ "$(cat "$p/comm" 2> /dev/null)" = termurion ] || continue
                    [ "${p#/proc/}" = "$old_app" ] && continue
                    tr '\0' '\n' < "$p/environ" 2> /dev/null | grep -qx "XDG_RUNTIME_DIR=$scratch/run" || continue
                    app_pid=${p#/proc/}
                done
                [ -n "$app_pid" ] && break
                sleep 0.2
            done
            [ -n "$app_pid" ] || fail "the host did not reopen Termurion"
            find_window
        fi
        reach_shape
        rc=$?
        [ "$rc" -eq 0 ] || { shoot; fail "the restored layout is not two tabs (one pane, then a split pair): step $rc, pids $(tr '\n' ' ' < "$scratch/pids") (see $scratch/screen.png)"; }
        shoot
        cp "$scratch/pids" "$scratch/pids2"
        if [ "$scenario" = restore-host ]; then
            [ "$single" = "$(sed -n 1p "$scratch/pids1")" ] || fail "the single-pane tab holds $single, not the first shell $(sed -n 1p "$scratch/pids1")"
            [ "$(printf '%s\n%s\n' "$pair1" "$pair2" | sort)" = "$(sed -n '2,3p' "$scratch/pids1" | sort)" ] || fail "the split tab holds $pair1 and $pair2, not the second and third shells"
            [ "$(sort -u "$scratch/pids1")" = "$(sort -u "$scratch/pids2")" ] || fail "pids2 ($(sort -u "$scratch/pids2" | tr '\n' ' ')) is not pids1 ($(sort -u "$scratch/pids1" | tr '\n' ' '))"
        else
            [ -z "$(sort -u "$scratch/pids1" "$scratch/pids2" | uniq -d)" ] || fail "a restored pane kept an old shell pid"
        fi
        ;;
    clipboard)
        sleep 1
        # Draw the word alone on row 0 (a screen clear without the scrollback one that asks a question),
        # then start a cat that writes a file, so nothing touches the screen after the drag below.
        xdotool type --delay 20 "printf '\\033[2J\\033[HSELECTME\\n'; cat > \"\$SCRATCH/got\""
        xdotool key Return
        sleep 1
        # A drag along row 0 selects the line; the primary selection must then hold the word.
        xdotool mousemove 2 10
        xdotool mousedown 1
        for x in 60 120 200 300; do xdotool mousemove "$x" 10; sleep 0.1; done
        xdotool mouseup 1
        sleep 1
        shoot
        got=$(timeout 5 "$xclip_bin" -o -selection primary 2> /dev/null | tr -d '\n' | sed 's/ *$//')
        [ "$got" = SELECTME ] || fail "the primary selection after a drag is '$got', not SELECTME"
        # Another program owns the selection now, while the drag's highlight stays in the pane: a
        # middle click pastes what the primary selection holds now, not the pane's old text.
        printf other | "$xclip_bin" -quiet -selection primary > /dev/null 2>&1 &
        xclip_pid=$!
        sleep 1
        xdotool mousemove 600 300
        xdotool click 2
        sleep 1
        xdotool key Return
        xdotool key ctrl+d
        for _ in $(seq 50); do [ -s "$scratch/got" ] && break; sleep 0.1; done
        shoot
        kill "$xclip_pid" 2> /dev/null
        [ "$(tr -d '\n' < "$scratch/got" 2> /dev/null)" = other ] || fail "the middle click did not paste 'other' (got '$(cat "$scratch/got" 2> /dev/null)')"
        ;;
    tmux | tmux-nolang | tmux-lcall | tmux-windows)
        sleep 1
        windows_before=$(xdotool search --onlyvisible --pid "$app_pid" 2> /dev/null | wc -l)
        # Control mode: the app drives the pane, and its first tmux window opens as a tab or a window.
        xdotool type --delay 20 'tmux -L guicheck -f /dev/null -CC new-session -s gui'
        xdotool key Return
        mode=""
        for _ in $(seq 100); do
            mode=$(tmux -L guicheck list-clients -F '#{client_control_mode}' 2> /dev/null | head -1)
            [ "$mode" = 1 ] && break
            sleep 0.1
        done
        [ "$mode" = 1 ] || fail "no control mode client on the guicheck server (client_control_mode '$mode')"
        sleep 3
        shoot
        if [ "$scenario" = tmux-windows ]; then
            # The default opens the tmux window as a window of its own: a second visible X window.
            windows_after=$(xdotool search --onlyvisible --pid "$app_pid" 2> /dev/null | wc -l)
            [ "$windows_after" -gt "$windows_before" ] || fail "no new Termurion window opened ($windows_before before, $windows_after after)"
            newwin=$(xdotool search --onlyvisible --pid "$app_pid" 2> /dev/null | grep -vx "$win" | tail -1)
            xdotool windowfocus --sync "$newwin" 2> /dev/null || true
            sleep 1
        fi
        type_pid_line
        shoot
        shell_pid=$(head -1 "$scratch/pids")
        server_pid=$(tmux -L guicheck display-message -p '#{pid}' 2> /dev/null)
        parent=$(ps -o ppid= -p "$shell_pid" | tr -d ' ')
        [ -n "$server_pid" ] && [ "$parent" = "$server_pid" ] || fail "the shell $shell_pid has parent '$parent', not the tmux server '$server_pid' (see $scratch/screen.png)"
        # The pid line came from a tmux pane (the new tab or window), not from the gateway's own shell.
        tmux -L guicheck list-panes -a -F '#{pane_pid}' | grep -qx "$shell_pid" || fail "pid $shell_pid is not the shell of a tmux pane"
        ;;
esac
kill -0 "$app_pid" 2> /dev/null || fail "the app died (see $scratch/app.log)"
# Settings and data land where the OS says, never in the temp folder.
[ -f "$scratch/home/.config/termurion/settings.toml" ] || fail "no settings.toml under \$HOME/.config/termurion"
[ ! -e "$scratch/tmp/Termurion" ] && [ ! -e "$scratch/tmp/termurion" ] || fail "the app wrote its folder into the temp folder"
echo "PASS $scenario"
